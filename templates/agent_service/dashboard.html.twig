{% extends 'layouts/dashboard.html.twig' %}

{% set pageHeading = 'Mon espace de travail' %}
{% set roleLabel = 'Agent de service' %}
{% set demoUser = 'Paul Martin' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/agent-service/dashboard', active: true},
    {label: 'Mes courriers', icon: 'bi-envelope', url: '/agent-service/courriers'},
    {label: 'Courriers du service', icon: 'bi-building', url: '/agent-service/courriers-service'},
    {label: 'Tâches à traiter', icon: 'bi-list-task', url: '/agent-service/taches'},
    {label: 'Recherche', icon: 'bi-search', url: '/agent-service/recherche'},
    {label: 'Historique', icon: 'bi-clock-history', url: '/agent-service/historique'}
] %}

{% block title %}Espace Agent de service | SGEC{% endblock %}

{% block dashboard_content %}

<div class="mb-4">
    <h1 class="page-title">Bonjour, M. Martin 👋</h1>
    <p class="muted">Retrouvez vos courriers affectés et suivez leur traitement.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="muted">À traiter</span>
                <i class="bi bi-inbox fs-4 text-primary"></i>
            </div>
            <div class="stat-number">07</div>
            <small class="muted">Courriers affectés</small>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="muted">En cours</span>
                <i class="bi bi-hourglass-split fs-4 text-info"></i>
            </div>
            <div class="stat-number">05</div>
            <small class="muted">Traitements commencés</small>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="muted">Traités</span>
                <i class="bi bi-check-circle fs-4 text-success"></i>
            </div>
            <div class="stat-number">24</div>
            <small class="muted">Traités par le mois</small>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span class="muted">Échéances proches</span>
                <i class="bi bi-alarm fs-4 text-warning"></i>
            </div>
            <div class="stat-number">02</div>
            <small class="text-warning">À surveiller</small>
        </div>
    </div>

</div>

{# Mes courriers affectés  #}
<div class="panel">
    <div class="panel-header">
        <h5><i class="bi bi-inbox me-2"></i>Mes courriers affectés</h5>
        <a href="/agent-service/courriers" class="btn btn-sm btn-outline-primary">
            Voir tous
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Référence</th>
                    <th>Objet</th>
                    <th>Échéance</th>
                    <th>Priorité</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ENT-2026-0012</td>
                    <td>Demande de matériel</td>
                    <td>05/11/2026</td>
                    <td><span class="badge bg-danger-subtle text-danger">Haute</span></td>
                    <td><span class="badge-status status-progress">En cours</span></td>
                    <td>
                        <a href="/agent-service/courriers/1" class="btn btn-sm btn-primary">
                            Ouvrir
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>INT-2026-0007</td>
                    <td>Note interne</td>
                    <td>06/11/2026</td>
                    <td><span class="badge bg-warning-subtle text-warning-emphasis">Moyenne</span></td>
                    <td><span class="badge-status status-pending">À traiter</span></td>
                    <td>
                        <a href="/agent-service/courriers/2" class="btn btn-sm btn-primary">
                            Ouvrir
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>ENT-2026-0015</td>
                    <td>Réclamation administrative</td>
                    <td>07/11/2026</td>
                    <td><span class="badge bg-danger-subtle text-danger">Haute</span></td>
                    <td><span class="badge-status status-progress">En cours</span></td>
                    <td>
                        <a href="/agent-service/courriers/3" class="btn btn-sm btn-primary">
                            Ouvrir
                        </a>
                    </td>
                </tr>

                <tr>
                    <td>INT-2026-0010</td>
                    <td>Information de service</td>
                    <td>10/11/2026</td>
                    <td><span class="badge bg-success-subtle text-success">Basse</span></td>
                    <td><span class="badge-status status-done">Traité</span></td>
                    <td>
                        <a href="/agent-service/courriers/4" class="btn btn-sm btn-outline-primary">
                            Consulter
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

{# Actions rapides #}
<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="panel h-100">
            <div class="panel-header">
                <h5><i class="bi bi-lightning-charge me-2"></i>Actions rapides</h5>
            </div>

            <div class="p-3 d-grid gap-3">
                <a href="/agent-service/taches" class="quick-action">
                    <i class="bi bi-list-check text-primary"></i>
                    <span>Consulter mes tâches</span>
                </a>

                <a href="/agent-service/recherche" class="quick-action">
                    <i class="bi bi-search text-success"></i>
                    <span>Rechercher un courrier</span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="panel h-100">
            <div class="panel-header">
                <h5><i class="bi bi-info-circle me-2"></i>Rappels</h5>
            </div>

            <div class="p-3">
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-alarm me-2"></i>
                    Vérifiez les échéances de vos courriers prioritaires.
                </div>

                <div class="alert alert-info mb-0">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Ajoutez un compte rendu avant de signaler un courrier comme traité.
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}