{% extends 'layouts/app.html.twig' %}
{% set pageHeading = 'Courriers' %}
{% block title %}Courriers | SGEC{% endblock %}

{% block content %}
<div class="page-heading">
    <div>
        <h1 class="page-title">Courriers</h1>
        <p class="muted mb-0">Recherchez et suivez les courriers accessibles à votre profil.</p>
    </div>
    <div class="d-flex gap-2">
        {% if is_granted('ROLE_AGENT_COURRIER') %}
            <a href="{{ path('app_export_csv') }}" class="btn btn-outline-secondary"><i class="bi bi-download me-2"></i>Export CSV</a>
            <a href="{{ path('app_courrier_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nouveau courrier</a>
        {% endif %}
    </div>
</div>

<div class="panel mb-4">
    <div class="panel-header"><h5>Recherche multicritère</h5></div>
    <div class="p-3">
        {{ form_start(searchForm, {attr: {class: 'row g-2'}}) }}
            <div class="col-md-3">{{ form_row(searchForm.reference) }}</div>
            <div class="col-md-3">{{ form_row(searchForm.objet) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.type) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.statut) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.priorite) }}</div>
            <div class="col-md-3">{{ form_row(searchForm.expediteur) }}</div>
            <div class="col-md-3">{{ form_row(searchForm.destinataire) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.service) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.date_debut) }}</div>
            <div class="col-md-2">{{ form_row(searchForm.date_fin) }}</div>
            <div class="col-12">
                <button class="btn btn-primary btn-sm" type="submit">Rechercher</button>
                <a href="{{ path('app_courrier_index') }}" class="btn btn-link btn-sm">Réinitialiser</a>
            </div>
        {{ form_end(searchForm) }}
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Référence</th><th>Objet</th><th>Type</th><th>Priorité</th><th>Statut</th><th>Date</th><th></th>
            </tr>
            </thead>
            <tbody>
            {% for c in courriers %}
                <tr>
                    <td>{{ c.reference }}</td>
                    <td>{{ c.objet }}</td>
                    <td>{{ c.type.label }}</td>
                    <td>{{ c.priorite.label }}</td>
                    <td><span class="badge-status {{ c.statut.badgeClass }}">{{ c.statut.label }}</span></td>
                    <td>{{ c.dateEnregistrement|date('d/m/Y') }}</td>
                    <td><a href="{{ path('app_courrier_show', {id: c.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center muted py-4">Aucun résultat</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
