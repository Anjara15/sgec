{% extends 'layouts/app.html.twig' %}
{% set pageHeading = 'Modifier ' ~ courrier.reference %}
{% block title %}Modifier courrier | SGEC{% endblock %}
{% block content %}
<div class="page-heading">
    <div>
        <h1 class="page-title">Modifier le courrier</h1>
        <p class="muted mb-0">Référence {{ courrier.reference }} · mettez à jour les informations du dossier.</p>
    </div>
</div>
<div class="panel">
    <div class="panel-header"><h2 class="h6 mb-0">Informations du courrier</h2></div>
    <div class="form-section">{% include 'courrier/_form.html.twig' %}</div>
</div>
{% endblock %}
