{% extends 'layouts/app.html.twig' %}
{% set pageHeading = 'Tableau de bord administrateur' %}
{% block title %}Administration | SGEC{% endblock %}

{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="page-title">Bonjour, {{ app.user.prenom }}</h1>
        <p class="muted mb-0">Vue d'ensemble du système SGEC.</p>
    </div>
    <span class="badge bg-white text-dark border p-2">
        <i class="bi bi-calendar3 me-2"></i>{{ "now"|date("d/m/Y") }}
    </span>
</div>

{% include 'dashboard/_stats.html.twig' %}
{% include 'dashboard/_distribution.html.twig' %}

<div class="resource-summary mb-4">
    <div><i class="bi bi-people"></i><span><strong>{{ stats.utilisateurs_actifs }}</strong> utilisateurs actifs</span></div>
    <span class="resource-divider" aria-hidden="true"></span>
    <div><i class="bi bi-building"></i><span><strong>{{ stats.services }}</strong> services</span></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="{{ path('app_user_new') }}" class="quick-action">
            <i class="bi bi-person-plus text-primary"></i>
            <div><div class="fw-bold">Ajouter un utilisateur</div><small class="muted">Créer un compte</small></div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('app_courrier_new') }}" class="quick-action">
            <i class="bi bi-envelope-plus text-success"></i>
            <div><div class="fw-bold">Nouveau courrier</div><small class="muted">Enregistrement</small></div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('app_export_rapport') }}" class="quick-action">
            <i class="bi bi-file-earmark-bar-graph text-warning"></i>
            <div><div class="fw-bold">Rapports</div><small class="muted">Statistiques & exports</small></div>
        </a>
    </div>
</div>

{% include 'dashboard/_recents.html.twig' %}
{% endblock %}
