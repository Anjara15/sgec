<div class="panel">
    <div class="panel-header">
        <h5>Derniers courriers</h5>
        <a href="{{ path('app_courrier_index') }}" class="btn btn-sm btn-outline-primary">Voir tous</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Référence</th>
                <th>Objet</th>
                <th>Type</th>
                <th>Service</th>
                <th>Statut</th>
            </tr>
            </thead>
            <tbody>
            {% for c in stats.recents %}
                <tr>
                    <td><a href="{{ path('app_courrier_show', {id: c.id}) }}">{{ c.reference }}</a></td>
                    <td>{{ c.objet }}</td>
                    <td>{{ c.type.label }}</td>
                    <td>{{ c.serviceDestinataire ? c.serviceDestinataire.nom : (c.serviceOrigine ? c.serviceOrigine.nom : '—') }}</td>
                    <td><span class="badge-status {{ c.statut.badgeClass }}">{{ c.statut.label }}</span></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center muted py-4">Aucun courrier</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h5><i class="bi bi-clock-history me-2"></i>Activités récentes</h5>
    </div>
    <div class="p-3">
        {% for a in stats.activites %}
            <div class="d-flex gap-3 mb-3">
                <i class="bi bi-activity fs-4 text-primary"></i>
                <div>
                    <div class="fw-semibold">{{ a.action }}</div>
                    <small class="muted">
                        {{ a.utilisateur ? a.utilisateur.nomComplet : 'Système' }}
                        — {{ a.date|date('d/m/Y H:i') }}
                    </small>
                </div>
            </div>
        {% else %}
            <p class="muted mb-0">Aucune activité récente.</p>
        {% endfor %}
    </div>
</div>
