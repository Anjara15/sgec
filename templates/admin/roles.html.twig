{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Administration - SGEC' %}
{% set pageHeading = 'Rôles et permissions' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles', active: true},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historique'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Rôles et permissions | SGEC{% endblock %}

{% block dashboard_content %}

<style>
.roles-page {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --surface: #fff;

    width: 100%;
    min-width: 0;
    color: var(--text);
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.roles-page *,
.roles-page *::before,
.roles-page *::after {
    box-sizing: border-box;
}

.roles-page .breadcrumb-custom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 12px;
}

.roles-page .breadcrumb-custom a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    text-decoration: none;
}

.roles-page .breadcrumb-custom a:hover {
    color: var(--primary);
}

.roles-page .breadcrumb-custom > i {
    color: #cbd5e1;
    font-size: 10px;
}

.roles-page .breadcrumb-custom span {
    color: var(--primary);
    font-weight: 600;
}

/* En-tête */

.roles-page .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 28px;
}

.roles-page .page-header h1 {
    margin: 0 0 8px;
    color: var(--text);
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 750;
    letter-spacing: -.8px;
}

.roles-page .page-header p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.roles-page .btn-primary-custom {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 18px;
    color: #fff;
    background: var(--primary);
    border: 1px solid var(--primary);
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 4px 12px #2563eb20;
    transition: all .2s ease;
}

.roles-page .btn-primary-custom:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
    transform: translateY(-1px);
}

/* Statistiques */

.roles-page .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
}

.roles-page .stat-card {
    min-width: 0;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 3px 15px #0f172a08;
    transition: transform .2s ease, box-shadow .2s ease;
}

.roles-page .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px #0f172a10;
}

.roles-page .stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
}

.roles-page .stat-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
}

.roles-page .stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    font-size: 20px;
}

.roles-page .icon-blue {
    color: #2563eb;
    background: #eff6ff;
}

.roles-page .icon-purple {
    color: #7c3aed;
    background: #f5f3ff;
}

.roles-page .icon-green {
    color: #16a34a;
    background: #f0fdf4;
}

.roles-page .icon-orange {
    color: #ea580c;
    background: #fff7ed;
}

.roles-page .stat-number {
    margin-bottom: 7px;
    font-size: 34px;
    font-weight: 750;
    letter-spacing: -1px;
}

.roles-page .stat-description {
    color: #94a3b8;
    font-size: 12px;
}

/* Panneau */

.roles-page .roles-panel {
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 3px 15px #0f172a08;
}

.roles-page .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding: 24px;
    border-bottom: 1px solid var(--border);
}

.roles-page .panel-header h2 {
    margin: 0 0 7px;
    font-size: 18px;
    font-weight: 700;
}

.roles-page .panel-header p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
}

.roles-page .filter-area {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.roles-page .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 250px;
    padding: 0 12px;
    border: 1px solid #dbe2ea;
    border-radius: 9px;
}

.roles-page .search-box:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px #2563eb15;
}

.roles-page .search-box i {
    color: #94a3b8;
}

.roles-page .search-box input {
    width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 12px;
}

.roles-page .filter-select {
    height: 44px;
    max-width: 100%;
    padding: 0 30px 0 12px;
    color: #334155;
    background: #fff;
    border: 1px solid #dbe2ea;
    border-radius: 9px;
    font-size: 12px;
    cursor: pointer;
    outline: none;
}

/* Tableau */

.roles-page .table-responsive {
    width: 100%;
    overflow-x: auto;
}

.roles-page .roles-table {
    width: 100%;
    min-width: 850px;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 12px;
}

.roles-page .roles-table thead {
    background: #f8fafc;
}

.roles-page .roles-table th {
    padding: 15px 18px;
    color: #64748b;
    text-align: left;
    white-space: nowrap;
    font-size: 10px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: .5px;
    border-bottom: 1px solid var(--border);
}

.roles-page .roles-table td {
    padding: 17px 18px;
    vertical-align: middle;
    border-bottom: 1px solid #f1f5f9;
}

.roles-page .roles-table tbody tr {
    background: #fff;
    transition: background .2s ease;
}

.roles-page .roles-table tbody tr:hover {
    background: #f8fbff;
}

.roles-page .roles-table tbody tr:last-child td {
    border-bottom: 0;
}

.roles-page .role-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 190px;
}

.roles-page .role-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px;
    font-size: 18px;
}

.roles-page .role-name {
    margin-bottom: 5px;
    color: #1e293b;
    font-size: 12px;
    font-weight: 700;
}

.roles-page .role-description {
    color: #94a3b8;
    font-size: 11px;
    line-height: 1.5;
}

.roles-page .role-admin .role-icon {
    color: #7c3aed;
    background: #f5f3ff;
}

.roles-page .role-agent .role-icon {
    color: #2563eb;
    background: #eff6ff;
}

.roles-page .role-responsable .role-icon {
    color: #d97706;
    background: #fffbeb;
}

.roles-page .role-service .role-icon {
    color: #0f766e;
    background: #f0fdfa;
}

.roles-page .permission-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    color: #475569;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 650;
    white-space: nowrap;
}

.roles-page .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
}

.roles-page .status-active {
    color: #15803d;
    background: #f0fdf4;
    border: 1px solid #dcfce7;
}

.roles-page .status-inactive {
    color: #b91c1c;
    background: #fef2f2;
    border: 1px solid #fee2e2;
}

.roles-page .action-buttons {
    display: flex;
    align-items: center;
    gap: 6px;
}

.roles-page .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: #64748b;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    transition: all .2s ease;
}

.roles-page .action-btn:hover {
    color: var(--primary);
    background: #eff6ff;
    border-color: #bfdbfe;
}

.roles-page .action-btn.delete:hover {
    color: #dc2626;
    background: #fef2f2;
    border-color: #fecaca;
}

/* État vide et pied du tableau */

.roles-page .empty-state {
    display: none;
    padding: 42px 20px;
    color: #64748b;
    text-align: center;
    font-size: 13px;
}

.roles-page .table-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    padding: 17px 24px;
    border-top: 1px solid var(--border);
}

.roles-page #resultCount {
    color: var(--muted);
    font-size: 12px;
}

.roles-page .pagination-buttons {
    display: flex;
    gap: 6px;
}

.roles-page .pagination-buttons button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 9px;
    color: #64748b;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 12px;
}

.roles-page .pagination-buttons button.active {
    color: #fff;
    background: var(--primary);
    border-color: var(--primary);
}

/* Modale */

#addRoleModal .modal-content {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 24px 70px #0f172a25;
}

#addRoleModal .modal-header {
    padding: 22px 24px;
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
}

#addRoleModal .modal-title {
    font-size: 18px;
    font-weight: 750;
}

#addRoleModal .modal-body {
    padding: 24px;
}

#addRoleModal .form-label {
    color: #334155;
    font-size: 12px;
    font-weight: 650;
}

#addRoleModal .form-control,
#addRoleModal .form-select {
    min-height: 43px;
    border-color: #dbe2ea;
    border-radius: 9px;
    font-size: 13px;
    box-shadow: none;
}

#addRoleModal .form-control:focus,
#addRoleModal .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px #2563eb15;
}

#addRoleModal .permissions-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

#addRoleModal .permission-option {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    cursor: pointer;
}

#addRoleModal .permission-option input {
    margin-top: 3px;
    accent-color: var(--primary);
}

#addRoleModal .permission-option span {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
}

@media (max-width: 1200px) {
    .roles-page .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .roles-page .panel-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .roles-page .filter-area {
        width: 100%;
    }

    .roles-page .search-box {
        flex: 1 1 220px;
    }
}

@media (max-width: 768px) {
    .roles-page .page-header {
        align-items: stretch;
        flex-direction: column;
    }

    .roles-page .btn-primary-custom {
        width: 100%;
    }

    .roles-page .stats-grid {
        gap: 12px;
    }

    .roles-page .stat-card {
        padding: 15px;
    }

    .roles-page .stat-number {
        font-size: 28px;
    }

    .roles-page .panel-header {
        padding: 20px 16px;
    }

    .roles-page .filter-area {
        display: grid;
        grid-template-columns: 1fr;
    }

    .roles-page .search-box {
        width: 100%;
    }

    .roles-page .filter-select {
        width: 100%;
    }

    .roles-page .table-footer {
        align-items: flex-start;
        flex-direction: column;
        padding: 16px;
    }
}

@media (max-width: 380px) {
    .roles-page .stats-grid {
        grid-template-columns: 1fr;
    }

    #addRoleModal .permissions-list {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="roles-page">

    <nav class="breadcrumb-custom" aria-label="Fil d'Ariane">
        <a href="/admin/dashboard">
            <i class="bi bi-house-door"></i>
            Tableau de bord
        </a>
        <i class="bi bi-chevron-right"></i>
        <span>Rôles et permissions</span>
    </nav>

    <div class="page-header">
        <div>
            <h1>Rôles et permissions</h1>
            <p>Contrôlez les accès et définissez les autorisations des utilisateurs du SGEC.</p>
        </div>

        <button type="button"
                class="btn-primary-custom"
                data-bs-toggle="modal"
                data-bs-target="#addRoleModal">
            <i class="bi bi-plus-lg"></i>
            Créer un rôle
        </button>
    </div>

    {# Rôles de démonstration #}
    {% set roles = [
        {
            nom: 'Administrateur',
            description: 'Administration complète du système',
            code: 'ADMIN',
            icone: 'bi-shield-lock',
            classe: 'role-admin',
            utilisateurs: 1,
            permissions: 12,
            statut: 'Actif'
        },
        {
            nom: 'Responsable',
            description: 'Supervision et validation des opérations',
            code: 'RESP',
            icone: 'bi-person-badge',
            classe: 'role-responsable',
            utilisateurs: 1,
            permissions: 8,
            statut: 'Actif'
        },
        {
            nom: 'Agent courrier',
            description: 'Enregistrement et suivi des courriers',
            code: 'AGENT',
            icone: 'bi-envelope-paper',
            classe: 'role-agent',
            utilisateurs: 2,
            permissions: 5,
            statut: 'Actif'
        },
        {
            nom: 'Agent de service',
            description: 'Accès aux fonctions de son service',
            code: 'SERVICE',
            icone: 'bi-people',
            classe: 'role-service',
            utilisateurs: 2,
            permissions: 4,
            statut: 'Actif'
        },
        {
            nom: 'Lecteur',
            description: 'Consultation des données autorisées',
            code: 'LECTEUR',
            icone: 'bi-eye',
            classe: 'role-agent',
            utilisateurs: 0,
            permissions: 2,
            statut: 'Inactif'
        }
    ] %}

    {# Statistiques #}
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Total des rôles</span>
                <div class="stat-icon icon-blue">
                    <i class="bi bi-shield"></i>
                </div>
            </div>
            <div class="stat-number" id="totalRoles">{{ roles|length }}</div>
            <div class="stat-description">Rôles configurés</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Rôles actifs</span>
                <div class="stat-icon icon-green">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <div class="stat-number" id="activeRoles">
                {{ roles|filter(r => r.statut == 'Actif')|length }}
            </div>
            <div class="stat-description">Rôles disponibles</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Permissions définies</span>
                <div class="stat-icon icon-purple">
                    <i class="bi bi-key"></i>
                </div>
            </div>
            <div class="stat-number" id="totalPermissions">12</div>
            <div class="stat-description">Autorisations système</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Utilisateurs attribués</span>
                <div class="stat-icon icon-orange">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="stat-number" id="assignedUsers">
                {{ roles|reduce((sum, r) => sum + r.utilisateurs, 0) }}
            </div>
            <div class="stat-description">Affectations de démonstration</div>
        </div>

    </div>

    {# Tableau #}
    <section class="roles-panel">

        <div class="panel-header">
            <div>
                <h2>Liste des rôles</h2>
                <p>Consultez les rôles, leurs permissions et les utilisateurs associés.</p>
            </div>

            <div class="filter-area">
                <label class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           id="searchRole"
                           placeholder="Rechercher un rôle..."
                           aria-label="Rechercher un rôle">
                </label>

                <select class="filter-select" id="statusFilter"
                        aria-label="Filtrer par statut">
                    <option value="">Tous les statuts</option>
                    <option value="Actif">Actif</option>
                    <option value="Inactif">Inactif</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="roles-table">
                <thead>
                    <tr>
                        <th>Rôle</th>
                        <th>Code</th>
                        <th>Utilisateurs</th>
                        <th>Permissions</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="rolesTableBody">
                    {% for role in roles %}
                        <tr class="role-row"
                            data-name="{{ role.nom|lower }}"
                            data-code="{{ role.code|lower }}"
                            data-status="{{ role.statut }}"
                            data-users="{{ role.utilisateurs }}"
                            data-permissions="{{ role.permissions }}">

                            <td>
                                <div class="role-cell {{ role.classe }}">
                                    <div class="role-icon">
                                        <i class="bi {{ role.icone }}"></i>
                                    </div>
                                    <div>
                                        <div class="role-name">{{ role.nom }}</div>
                                        <div class="role-description">
                                            {{ role.description }}
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <code>{{ role.code }}</code>
                            </td>

                            <td>
                                <span class="permission-count">
                                    <i class="bi bi-people"></i>
                                    {{ role.utilisateurs }}
                                </span>
                            </td>

                            <td>
                                <span class="permission-count">
                                    <i class="bi bi-key"></i>
                                    {{ role.permissions }} permissions
                                </span>
                            </td>

                            <td>
                                <span class="status-badge {{ role.statut == 'Actif' ? 'status-active' : 'status-inactive' }}">
                                    <i class="bi {{ role.statut == 'Actif' ? 'bi-check-circle' : 'bi-x-circle' }}"></i>
                                    {{ role.statut }}
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">
                                    <button type="button"
                                            class="action-btn"
                                            title="Voir les permissions"
                                            aria-label="Voir les permissions de {{ role.nom }}"
                                            onclick="viewRole(this)">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <button type="button"
                                            class="action-btn"
                                            title="Modifier le rôle"
                                            aria-label="Modifier {{ role.nom }}"
                                            onclick="editRole(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Supprimer le rôle"
                                            aria-label="Supprimer {{ role.nom }}"
                                            onclick="deleteRole(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div id="emptyState" class="empty-state">
                <i class="bi bi-search fs-3 d-block mb-3"></i>
                <strong>Aucun rôle trouvé</strong>
                <p class="mt-2 mb-0">Modifiez votre recherche ou le filtre de statut.</p>
            </div>
        </div>

        <div class="table-footer">
            <span id="resultCount">Affichage de {{ roles|length }} rôles</span>

            <div class="pagination-buttons">
                <button type="button" aria-label="Page précédente" disabled>
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="active" aria-current="page">1</button>
                <button type="button" aria-label="Page suivante" disabled>
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

    </section>
</div>

{# Modale de création d'un rôle #}
<div class="modal fade"
     id="addRoleModal"
     tabindex="-1"
     aria-labelledby="addRoleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="addRoleModalLabel">Créer un rôle</h5>
                    <small class="text-secondary">
                        Définissez un rôle et ses autorisations.
                    </small>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer"></button>
            </div>

            <div class="modal-body">
                <form id="addRoleForm">

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="newRoleName" class="form-label">Nom du rôle</label>
                            <input type="text"
                                   id="newRoleName"
                                   class="form-control"
                                   placeholder="Ex. : Contrôleur"
                                   required>
                        </div>

                        <div class="col-md-6">
                            <label for="newRoleCode" class="form-label">Code du rôle</label>
                            <input type="text"
                                   id="newRoleCode"
                                   class="form-control"
                                   placeholder="Ex. : CONTROLEUR"
                                   pattern="[A-Za-z0-9_-]+"
                                   required>
                        </div>

                        <div class="col-12">
                            <label for="newRoleDescription" class="form-label">
                                Description
                            </label>
                            <input type="text"
                                   id="newRoleDescription"
                                   class="form-control"
                                   placeholder="Décrivez les responsabilités de ce rôle"
                                   required>
                        </div>
                    </div>

                    <h6 class="mb-3 fw-bold">Permissions du rôle</h6>

                    <div class="permissions-list mb-4">
                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="dashboard">
                            <span>Consulter le tableau de bord</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="users">
                            <span>Gérer les utilisateurs</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="roles">
                            <span>Gérer les rôles</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="services">
                            <span>Gérer les services</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="courriers">
                            <span>Gérer les courriers</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="statistics">
                            <span>Consulter les statistiques</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="history">
                            <span>Consulter le journal d'activité</span>
                        </label>

                        <label class="permission-option">
                            <input type="checkbox" name="permissions" value="settings">
                            <span>Accéder aux paramètres</span>
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button"
                                class="btn btn-light border"
                                data-bs-dismiss="modal">
                            Annuler
                        </button>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>
                            Créer le rôle
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tableBody = document.getElementById('rolesTableBody');
    const searchInput = document.getElementById('searchRole');
    const statusFilter = document.getElementById('statusFilter');
    const emptyState = document.getElementById('emptyState');
    const resultCount = document.getElementById('resultCount');

    function filterRoles() {
        const search = searchInput.value.toLowerCase().trim();
        const status = statusFilter.value;
        const rows = [...tableBody.querySelectorAll('.role-row')];
        let count = 0;

        rows.forEach(function (row) {
            const matchesSearch =
                row.dataset.name.includes(search) ||
                row.dataset.code.includes(search);

            const matchesStatus =
                !status || row.dataset.status === status;

            const visible = matchesSearch && matchesStatus;
            row.style.display = visible ? '' : 'none';

            if (visible) count++;
        });

        resultCount.textContent =
            'Affichage de ' + count + ' rôle' + (count > 1 ? 's' : '');

        emptyState.style.display = count === 0 ? 'block' : 'none';
    }

    function updateStats() {
        const rows = [...tableBody.querySelectorAll('.role-row')];

        const active = rows.filter(
            row => row.dataset.status === 'Actif'
        ).length;

        const assigned = rows.reduce(
            (sum, row) => sum + Number(row.dataset.users || 0), 0
        );

        document.getElementById('totalRoles').textContent = rows.length;
        document.getElementById('activeRoles').textContent = active;
        document.getElementById('assignedUsers').textContent = assigned;
    }

    searchInput.addEventListener('input', filterRoles);
    statusFilter.addEventListener('change', filterRoles);

    window.viewRole = function (button) {
        const row = button.closest('.role-row');
        const name = row.dataset.name;
        const code = row.dataset.code;
        const permissions = row.dataset.permissions;

        alert(
            'Rôle : ' + name +
            '\nCode : ' + code +
            '\nNombre de permissions : ' + permissions +
            '\n\nLe détail des permissions sera connecté au backend Symfony.'
        );
    };

    window.editRole = function (button) {
        const row = button.closest('.role-row');
        alert(
            'Modification du rôle : ' + row.dataset.name +
            '\n\nLe formulaire de modification sera connecté au backend Symfony.'
        );
    };

    window.deleteRole = function (button) {
        const row = button.closest('.role-row');
        const name = row.dataset.name;
        const users = Number(row.dataset.users || 0);

        if (users > 0) {
            alert(
                'Ce rôle est encore attribué à ' + users +
                ' utilisateur(s). Réaffectez ces utilisateurs avant de le supprimer.'
            );
            return;
        }

        if (!confirm('Voulez-vous supprimer le rôle « ' + name + ' » du tableau de démonstration ?')) {
            return;
        }

        row.remove();
        filterRoles();
        updateStats();
    };

    document.getElementById('addRoleForm').addEventListener('submit', function (event) {
        event.preventDefault();

        const name = document.getElementById('newRoleName').value.trim();
        const code = document.getElementById('newRoleCode').value.trim().toUpperCase();
        const description = document.getElementById('newRoleDescription').value.trim();
        const selectedPermissions = [
            ...this.querySelectorAll('input[name="permissions"]:checked')
        ];

        if (!name || !code || !description) return;

        const existing = [...tableBody.querySelectorAll('.role-row')].some(
            row => row.dataset.code.toUpperCase() === code
        );

        if (existing) {
            alert('Un rôle portant ce code existe déjà.');
            return;
        }

        const row = document.createElement('tr');
        row.className = 'role-row';
        row.dataset.name = name.toLowerCase();
        row.dataset.code = code.toLowerCase();
        row.dataset.status = 'Actif';
        row.dataset.users = '0';
        row.dataset.permissions = String(selectedPermissions.length);

        const identityCell = document.createElement('td');
        const roleCell = document.createElement('div');
        roleCell.className = 'role-cell role-agent';

        const iconBox = document.createElement('div');
        iconBox.className = 'role-icon';

        const icon = document.createElement('i');
        icon.className = 'bi bi-shield';
        iconBox.append(icon);

        const info = document.createElement('div');
        const roleName = document.createElement('div');
        roleName.className = 'role-name';
        roleName.textContent = name;

        const roleDescription = document.createElement('div');
        roleDescription.className = 'role-description';
        roleDescription.textContent = description;

        info.append(roleName, roleDescription);
        roleCell.append(iconBox, info);
        identityCell.append(roleCell);

        const codeCell = document.createElement('td');
        const codeElement = document.createElement('code');
        codeElement.textContent = code;
        codeCell.append(codeElement);

        const usersCell = document.createElement('td');
        const usersBadge = document.createElement('span');
        usersBadge.className = 'permission-count';

        const usersIcon = document.createElement('i');
        usersIcon.className = 'bi bi-people';
        usersBadge.append(usersIcon, document.createTextNode(' 0'));
        usersCell.append(usersBadge);

        const permissionsCell = document.createElement('td');
        const permissionsBadge = document.createElement('span');
        permissionsBadge.className = 'permission-count';

        const permissionsIcon = document.createElement('i');
        permissionsIcon.className = 'bi bi-key';
        permissionsBadge.append(
            permissionsIcon,
            document.createTextNode(' ' + selectedPermissions.length + ' permissions')
        );
        permissionsCell.append(permissionsBadge);

        const statusCell = document.createElement('td');
        const statusBadge = document.createElement('span');
        statusBadge.className = 'status-badge status-active';

        const statusIcon = document.createElement('i');
        statusIcon.className = 'bi bi-check-circle';

        statusBadge.append(statusIcon, document.createTextNode(' Actif'));
        statusCell.append(statusBadge);

        const actionsCell = document.createElement('td');
        const actions = document.createElement('div');
        actions.className = 'action-buttons';

        [
            {icon: 'bi-eye', title: 'Voir', action: 'view'},
            {icon: 'bi-pencil', title: 'Modifier', action: 'edit'},
            {icon: 'bi-trash', title: 'Supprimer', action: 'delete'}
        ].forEach(function (item) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'action-btn' +
                (item.action === 'delete' ? ' delete' : '');
            button.title = item.title;
            button.setAttribute('aria-label', item.title);

            const buttonIcon = document.createElement('i');
            buttonIcon.className = 'bi ' + item.icon;
            button.append(buttonIcon);

            if (item.action === 'view') {
                button.addEventListener('click', () => window.viewRole(button));
            } else if (item.action === 'edit') {
                button.addEventListener('click', () => window.editRole(button));
            } else {
                button.addEventListener('click', () => window.deleteRole(button));
            }

            actions.append(button);
        });

        actionsCell.append(actions);

        row.append(
            identityCell,
            codeCell,
            usersCell,
            permissionsCell,
            statusCell,
            actionsCell
        );

        tableBody.append(row);

        updateStats();
        filterRoles();

        const modalElement = document.getElementById('addRoleModal');
        const modalInstance = bootstrap.Modal.getInstance(modalElement);

        if (modalInstance) modalInstance.hide();

        this.reset();
    });

    updateStats();
    filterRoles();
});
</script>

{% endblock %}
