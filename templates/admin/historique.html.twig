
{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Administration - SGEC' %}
{% set pageHeading = 'Journal d’activité' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historiques', active: true},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Journal d’activité | SGEC{% endblock %}

{% block dashboard_content %}

<div class="history-page">

    {# En-tête #}
    <div class="history-header">
        <div>
            <span class="history-eyebrow">
                <i class="bi bi-shield-check"></i>
                SÉCURITÉ ET TRAÇABILITÉ
            </span>
            <h2>Journal d’activité</h2>
            <p>Consultez les actions effectuées par les utilisateurs dans le système SGEC.</p>
        </div>

        <button type="button" class="history-export" onclick="exportHistory()">
            <i class="bi bi-download"></i>
            Exporter le journal
        </button>
    </div>

    {# Cartes récapitulatives #}
    <div class="history-stats">

        <div class="history-stat">
            <div class="history-stat-icon icon-blue">
                <i class="bi bi-activity"></i>
            </div>
            <div>
                <span>Total des activités</span>
                <strong id="totalActivities">248</strong>
                <small>Événements enregistrés</small>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon icon-green">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <span>Connexions</span>
                <strong id="loginActivities">86</strong>
                <small>Authentifications réussies</small>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon icon-purple">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <span>Modifications</span>
                <strong id="editActivities">74</strong>
                <small>Données modifiées</small>
            </div>
        </div>

        <div class="history-stat">
            <div class="history-stat-icon icon-orange">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <span>Actions sensibles</span>
                <strong id="sensitiveActivities">12</strong>
                <small>Suppressions ou changements sensibles</small>
            </div>
        </div>

    </div>

    {# Filtres de recherche #}
    <section class="history-panel">
        <div class="history-filter-heading">
            <div>
                <h3>Rechercher dans le journal</h3>
                <p>Filtrez les événements par utilisateur, action, date ou catégorie.</p>
            </div>
            <span class="filter-heading-icon">
                <i class="bi bi-funnel"></i>
            </span>
        </div>

        <div class="history-filters">
            <div class="history-field history-search-field">
                <label for="historySearch">Recherche</label>
                <div class="history-input-wrapper">
                    <i class="bi bi-search"></i>
                    <input
                        type="search"
                        id="historySearch"
                        placeholder="Nom, action, adresse IP..."
                    >
                </div>
            </div>

            <div class="history-field">
                <label for="actionFilter">Type d’action</label>
                <select id="actionFilter">
                    <option value="all">Toutes les actions</option>
                    <option value="connexion">Connexion</option>
                    <option value="creation">Création</option>
                    <option value="modification">Modification</option>
                    <option value="suppression">Suppression</option>
                    <option value="consultation">Consultation</option>
                    <option value="deconnexion">Déconnexion</option>
                </select>
            </div>

            <div class="history-field">
                <label for="moduleFilter">Module</label>
                <select id="moduleFilter">
                    <option value="all">Tous les modules</option>
                    <option value="utilisateurs">Utilisateurs</option>
                    <option value="courriers">Courriers</option>
                    <option value="services">Services</option>
                    <option value="roles">Rôles et permissions</option>
                    <option value="authentification">Authentification</option>
                    <option value="parametres">Paramètres</option>
                </select>
            </div>

            <div class="history-field">
                <label for="dateFilter">Période</label>
                <select id="dateFilter">
                    <option value="all">Toutes les dates</option>
                    <option value="today">Aujourd’hui</option>
                    <option value="week">7 derniers jours</option>
                    <option value="month">30 derniers jours</option>
                </select>
            </div>

            <button type="button" class="history-filter-button" onclick="filterHistory()">
                <i class="bi bi-search"></i>
                Filtrer
            </button>

            <button type="button" class="history-reset-button" onclick="resetHistoryFilters()" title="Réinitialiser les filtres">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
        </div>
    </section>

    {# Tableau du journal #}
    <section class="history-panel history-table-panel">

        <div class="history-table-header">
            <div>
                <h3>Historique des activités</h3>
                <p>
                    <span id="visibleHistoryCount">8</span>
                    activité(s) affichée(s)
                </p>
            </div>

            <span class="history-live-label">
                <span class="live-dot"></span>
                Journal système
            </span>
        </div>

        <div class="history-table-wrapper">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Date et heure</th>
                        <th>Utilisateur</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>Description</th>
                        <th>Adresse IP</th>
                        <th>Résultat</th>
                    </tr>
                </thead>

                <tbody id="historyTableBody">

                    <tr
                        data-action="connexion"
                        data-module="authentification"
                        data-date="2026-10-28"
                    >
                        <td>
                            <div class="history-date">
                                <strong>28/10/2026</strong>
                                <small>14:25:10</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-blue">AM</span>
                                <div><strong>Anjara Mickael</strong><small>Administrateur</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-login"><i class="bi bi-box-arrow-in-right"></i> Connexion</span></td>
                        <td><span class="module-label">Authentification</span></td>
                        <td class="history-description">Connexion à l’espace d’administration</td>
                        <td><code>192.168.1.10</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="creation"
                        data-module="utilisateurs"
                        data-date="2026-10-28"
                    >
                        <td>
                            <div class="history-date">
                                <strong>28/10/2026</strong>
                                <small>13:58:42</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-purple">JD</span>
                                <div><strong>Jean Dupont</strong><small>Administrateur</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-create"><i class="bi bi-plus-circle"></i> Création</span></td>
                        <td><span class="module-label">Utilisateurs</span></td>
                        <td class="history-description">Création du compte utilisateur « Marie R. »</td>
                        <td><code>192.168.1.12</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="modification"
                        data-module="courriers"
                        data-date="2026-10-28"
                    >
                        <td>
                            <div class="history-date">
                                <strong>28/10/2026</strong>
                                <small>11:42:18</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-green">SR</span>
                                <div><strong>Sarah R.</strong><small>Agent courrier</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-edit"><i class="bi bi-pencil-square"></i> Modification</span></td>
                        <td><span class="module-label">Courriers</span></td>
                        <td class="history-description">Mise à jour du statut du courrier CR-2026-104</td>
                        <td><code>192.168.1.18</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="suppression"
                        data-module="roles"
                        data-date="2026-10-28"
                    >
                        <td>
                            <div class="history-date">
                                <strong>28/10/2026</strong>
                                <small>10:17:33</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-orange">AM</span>
                                <div><strong>Anjara Mickael</strong><small>Administrateur</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-delete"><i class="bi bi-trash"></i> Suppression</span></td>
                        <td><span class="module-label">Rôles et permissions</span></td>
                        <td class="history-description">Suppression d’un rôle de démonstration</td>
                        <td><code>192.168.1.10</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="consultation"
                        data-module="services"
                        data-date="2026-10-27"
                    >
                        <td>
                            <div class="history-date">
                                <strong>27/10/2026</strong>
                                <small>16:32:05</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-cyan">PL</span>
                                <div><strong>Paul L.</strong><small>Responsable</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-view"><i class="bi bi-eye"></i> Consultation</span></td>
                        <td><span class="module-label">Services</span></td>
                        <td class="history-description">Consultation de la liste des services</td>
                        <td><code>192.168.1.21</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="connexion"
                        data-module="authentification"
                        data-date="2026-10-27"
                    >
                        <td>
                            <div class="history-date">
                                <strong>27/10/2026</strong>
                                <small>15:08:51</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-red">MK</span>
                                <div><strong>Michel K.</strong><small>Agent courrier</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-login"><i class="bi bi-box-arrow-in-right"></i> Connexion</span></td>
                        <td><span class="module-label">Authentification</span></td>
                        <td class="history-description">Tentative de connexion avec identifiants incorrects</td>
                        <td><code>192.168.1.31</code></td>
                        <td><span class="result-badge result-failed"><i class="bi bi-x-circle"></i> Échec</span></td>
                    </tr>

                    <tr
                        data-action="modification"
                        data-module="parametres"
                        data-date="2026-10-26"
                    >
                        <td>
                            <div class="history-date">
                                <strong>26/10/2026</strong>
                                <small>14:05:20</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-blue">AM</span>
                                <div><strong>Anjara Mickael</strong><small>Administrateur</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-edit"><i class="bi bi-pencil-square"></i> Modification</span></td>
                        <td><span class="module-label">Paramètres</span></td>
                        <td class="history-description">Modification des paramètres généraux</td>
                        <td><code>192.168.1.10</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                    <tr
                        data-action="deconnexion"
                        data-module="authentification"
                        data-date="2026-10-26"
                    >
                        <td>
                            <div class="history-date">
                                <strong>26/10/2026</strong>
                                <small>12:30:00</small>
                            </div>
                        </td>
                        <td>
                            <div class="history-user">
                                <span class="history-avatar avatar-purple">JD</span>
                                <div><strong>Jean Dupont</strong><small>Administrateur</small></div>
                            </div>
                        </td>
                        <td><span class="action-badge action-logout"><i class="bi bi-box-arrow-right"></i> Déconnexion</span></td>
                        <td><span class="module-label">Authentification</span></td>
                        <td class="history-description">Déconnexion de la session utilisateur</td>
                        <td><code>192.168.1.12</code></td>
                        <td><span class="result-badge result-success"><i class="bi bi-check-circle"></i> Réussi</span></td>
                    </tr>

                </tbody>
            </table>

            <div id="historyEmpty" class="history-empty" hidden>
                <i class="bi bi-search"></i>
                <strong>Aucune activité trouvée</strong>
                <span>Essayez de modifier les filtres de recherche.</span>
            </div>
        </div>

        <div class="history-table-footer">
            <span>Journal d’activité — SGEC</span>
            <span id="historyFooterCount">8 événements</span>
        </div>
    </section>

    <div class="history-notice">
        <i class="bi bi-info-circle"></i>
        Les événements affichés sont des exemples de démonstration. En production, le journal doit être alimenté par le serveur et protégé contre les modifications non autorisées.
    </div>

</div>

<style>
.history-page {
    --history-primary: #315bea;
    --history-text: #192743;
    --history-muted: #7b879b;
    --history-border: #e8edf5;
    color: var(--history-text);
    padding-bottom: 28px;
}
.history-page * { box-sizing: border-box; }

.history-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:25px;
}
.history-eyebrow {
    display:inline-flex;
    gap:7px;
    margin-bottom:10px;
    color:var(--history-primary);
    font-size:10px;
    font-weight:800;
    letter-spacing:1.3px;
}
.history-header h2 {
    margin:0 0 8px;
    font-size:27px;
    font-weight:750;
    letter-spacing:-.6px;
}
.history-header p {
    margin:0;
    color:var(--history-muted);
    font-size:13px;
}
.history-export,.history-filter-button,.history-reset-button {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    border:0;
    border-radius:9px;
    padding:11px 15px;
    font-size:12px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}
.history-export,.history-filter-button {
    background:var(--history-primary);
    color:#fff;
}
.history-export:hover,.history-filter-button:hover {
    background:#2347c5;
}
.history-reset-button {
    min-width:40px;
    background:#f0f3fa;
    color:#53617a;
}
.history-reset-button:hover { background:#e5eaf5; }

.history-stats {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:16px;
    margin-bottom:22px;
}
.history-stat {
    display:flex;
    align-items:center;
    gap:14px;
    min-width:0;
    padding:20px;
    background:#fff;
    border:1px solid var(--history-border);
    border-radius:13px;
    box-shadow:0 3px 12px #192f5905;
}
.history-stat-icon {
    display:grid;
    place-items:center;
    flex-shrink:0;
    width:45px;
    height:45px;
    border-radius:12px;
    font-size:20px;
}
.icon-blue { background:#edf2ff; color:#315bea; }
.icon-green { background:#e6f8ef; color:#1da56a; }
.icon-purple { background:#f2edff; color:#8759dc; }
.icon-orange { background:#fff3e7; color:#e58b26; }
.history-stat div:last-child {
    display:flex;
    flex-direction:column;
    min-width:0;
}
.history-stat span {
    color:#6f7b91;
    font-size:11px;
}
.history-stat strong {
    margin:5px 0;
    color:#192743;
    font-size:25px;
    line-height:1.2;
    font-weight:800;
}
.history-stat small {
    color:#929caf;
    font-size:10px;
}

.history-panel {
    min-width:0;
    margin-bottom:22px;
    padding:22px;
    background:#fff;
    border:1px solid var(--history-border);
    border-radius:13px;
    box-shadow:0 3px 12px #192f5905;
}
.history-filter-heading,.history-table-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    margin-bottom:22px;
}
.history-filter-heading h3,.history-table-header h3 {
    margin:0 0 7px;
    color:#1c2943;
    font-size:15px;
    font-weight:750;
}
.history-filter-heading p,.history-table-header p {
    margin:0;
    color:var(--history-muted);
    font-size:12px;
}
.filter-heading-icon {
    display:grid;
    place-items:center;
    width:38px;
    height:38px;
    border-radius:10px;
    background:#eff3ff;
    color:var(--history-primary);
    font-size:17px;
}
.history-filters {
    display:grid;
    grid-template-columns:minmax(180px,1.5fr) repeat(3,minmax(135px,1fr)) auto auto;
    align-items:end;
    gap:12px;
}
.history-field {
    display:flex;
    flex-direction:column;
    gap:7px;
    min-width:0;
}
.history-field label {
    color:#778399;
    font-size:10px;
    font-weight:750;
}
.history-field input,.history-field select {
    width:100%;
    min-width:0;
    height:40px;
    padding:0 11px;
    border:1px solid #e2e8f2;
    border-radius:8px;
    background:#fbfcff;
    color:#35415b;
    font-size:11px;
    outline:none;
}
.history-field input:focus,.history-field select:focus {
    border-color:var(--history-primary);
}
.history-input-wrapper { position:relative; }
.history-input-wrapper i {
    position:absolute;
    left:11px;
    top:50%;
    transform:translateY(-50%);
    color:#8994a7;
    font-size:13px;
}
.history-input-wrapper input { padding-left:32px; }
.history-filter-button,.history-reset-button { height:40px; }

.history-live-label {
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:7px 10px;
    border-radius:20px;
    background:#e9f8ef;
    color:#19945c;
    font-size:10px;
    font-weight:750;
    white-space:nowrap;
}
.live-dot {
    width:7px;
    height:7px;
    border-radius:50%;
    background:#24b878;
}

.history-table-wrapper {
    width:100%;
    overflow-x:auto;
}
.history-table {
    width:100%;
    border-collapse:collapse;
    white-space:nowrap;
}
.history-table thead th {
    padding:13px 12px;
    background:#f8faff;
    border-block:1px solid #eef1f7;
    color:#8590a4;
    text-align:left;
    font-size:10px;
    font-weight:750;
    text-transform:uppercase;
    letter-spacing:.35px;
}
.history-table tbody td {
    padding:15px 12px;
    border-bottom:1px solid #f0f2f7;
    color:#526078;
    font-size:11px;
    vertical-align:middle;
}
.history-table tbody tr:hover { background:#fafbff; }
.history-table tbody tr:last-child td { border-bottom:0; }

.history-date { display:flex; flex-direction:column; gap:5px; }
.history-date strong { color:#35415a; font-size:11px; }
.history-date small { color:#8a95a7; font-size:10px; }

.history-user { display:flex; align-items:center; gap:9px; }
.history-avatar {
    display:grid;
    place-items:center;
    flex-shrink:0;
    width:34px;
    height:34px;
    border-radius:10px;
    font-size:10px;
    font-weight:800;
}
.avatar-blue { background:#eaf0ff; color:#315bea; }
.avatar-purple { background:#f0eaff; color:#8658d8; }
.avatar-green { background:#e3f8ed; color:#169c60; }
.avatar-orange { background:#fff0df; color:#d98625; }
.avatar-cyan { background:#e3f8fb; color:#1699ad; }
.avatar-red { background:#ffe9eb; color:#d94b58; }
.history-user strong,.history-user small { display:block; }
.history-user strong { margin-bottom:4px; color:#35415a; font-size:11px; }
.history-user small { color:#8a95a7; font-size:10px; }

.action-badge,.result-badge {
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:6px 8px;
    border-radius:6px;
    font-size:10px;
    font-weight:750;
}
.action-login { background:#eaf0ff; color:#315bea; }
.action-create { background:#e5f8ee; color:#19965e; }
.action-edit { background:#f0eaff; color:#8055d2; }
.action-delete { background:#ffe9eb; color:#d64a56; }
.action-view { background:#e5f7fa; color:#168b9e; }
.action-logout { background:#f0f2f7; color:#647087; }

.module-label { color:#647087; font-size:10px; }
.history-description { min-width:200px; white-space:normal; line-height:1.5; }
.history-table code {
    padding:4px 6px;
    border-radius:5px;
    background:#f3f5fa;
    color:#66738b;
    font-size:10px;
}
.result-success { background:#e5f8ee; color:#19965e; }
.result-failed { background:#ffe9eb; color:#d64a56; }

.history-table-footer {
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding-top:16px;
    color:#8994a7;
    font-size:10px;
}
.history-empty {
    padding:45px 15px;
    text-align:center;
    color:#7b879b;
}
.history-empty i {
    display:block;
    margin-bottom:12px;
    color:#9ba7bb;
    font-size:30px;
}
.history-empty strong,.history-empty span { display:block; }
.history-empty strong { margin-bottom:7px; color:#35415a; font-size:14px; }
.history-empty span { font-size:12px; }

.history-notice {
    display:flex;
    align-items:flex-start;
    gap:9px;
    padding:13px 15px;
    background:#f4f7ff;
    border:1px solid #e6ecff;
    border-radius:9px;
    color:#718099;
    font-size:11px;
    line-height:1.6;
}
.history-notice i { color:#315bea; margin-top:2px; }

@media(max-width:1200px) {
    .history-stats { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .history-filters { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(max-width:700px) {
    .history-header { align-items:flex-start; flex-direction:column; }
    .history-header h2 { font-size:23px; }
    .history-stats { grid-template-columns:1fr; }
    .history-panel { padding:16px; }
    .history-filters { grid-template-columns:1fr; }
    .history-filter-button { width:100%; }
    .history-reset-button { width:100%; }
    .history-table-header { align-items:flex-start; flex-direction:column; }
}
</style>

<script>
function filterHistory() {
    const search = document.getElementById('historySearch').value
        .trim().toLocaleLowerCase('fr');
    const action = document.getElementById('actionFilter').value;
    const module = document.getElementById('moduleFilter').value;
    const period = document.getElementById('dateFilter').value;

    // La date utilisée ici est celle du navigateur.
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    let visible = 0;

    document.querySelectorAll('#historyTableBody tr').forEach(row => {
        const text = row.textContent.toLocaleLowerCase('fr');
        const rowAction = row.dataset.action;
        const rowModule = row.dataset.module;
        const rowDate = new Date(row.dataset.date + 'T00:00:00');

        let matchesDate = true;

        if (period === 'today') {
            matchesDate = rowDate.getTime() === today.getTime();
        } else if (period === 'week') {
            const start = new Date(today);
            start.setDate(start.getDate() - 6);
            matchesDate = rowDate >= start && rowDate <= today;
        } else if (period === 'month') {
            const start = new Date(today);
            start.setDate(start.getDate() - 29);
            matchesDate = rowDate >= start && rowDate <= today;
        }

        const matchesSearch = !search || text.includes(search);
        const matchesAction = action === 'all' || rowAction === action;
        const matchesModule = module === 'all' || rowModule === module;

        const show = matchesSearch && matchesAction &&
            matchesModule && matchesDate;

        row.hidden = !show;

        if (show) visible++;
    });

    document.getElementById('visibleHistoryCount').textContent = visible;
    document.getElementById('historyFooterCount').textContent =
        visible + (visible > 1 ? ' événements' : ' événement');
    document.getElementById('historyEmpty').hidden = visible !== 0;
}

function resetHistoryFilters() {
    document.getElementById('historySearch').value = '';
    document.getElementById('actionFilter').value = 'all';
    document.getElementById('moduleFilter').value = 'all';
    document.getElementById('dateFilter').value = 'all';
    filterHistory();
}

function exportHistory() {
    const headers = [
        'Date', 'Heure', 'Utilisateur', 'Action',
        'Module', 'Description', 'Adresse IP', 'Résultat'
    ];

    const rows = [headers];

    document.querySelectorAll('#historyTableBody tr').forEach(row => {
        if (row.hidden) return;

        const cells = row.querySelectorAll('td');
        rows.push([
            cells[0].querySelector('strong')?.innerText ?? '',
            cells[0].querySelector('small')?.innerText ?? '',
            cells[1].innerText.replace(/\n/g, ' ').trim(),
            cells[2].innerText.trim(),
            cells[3].innerText.trim(),
            cells[4].innerText.trim(),
            cells[5].innerText.trim(),
            cells[6].innerText.trim()
        ]);
    });

    const csv = '\uFEFF' + rows.map(row =>
        row.map(value => '"' + String(value).replace(/"/g, '""') + '"')
            .join(';')
    ).join('\r\n');

    const blob = new Blob([csv], {
        type: 'text/csv;charset=utf-8;'
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');

    link.href = url;
    link.download = 'journal-activite-sgec.csv';
    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);
}

document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('historySearch')
        .addEventListener('input', filterHistory);

    document.getElementById('actionFilter')
        .addEventListener('change', filterHistory);

    document.getElementById('moduleFilter')
        .addEventListener('change', filterHistory);

    document.getElementById('dateFilter')
        .addEventListener('change', filterHistory);

    filterHistory();
});
</script>

{% endblock %}
