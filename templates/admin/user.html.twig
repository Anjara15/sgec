{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Administration - SGEC' %}
{% set pageHeading = 'Gestion des utilisateurs' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs', active: true},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historique'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Gestion des utilisateurs | SGEC{% endblock %}

{% block dashboard_content %}

<style>
    /* ==========================================
       DESIGN GÉNÉRAL
    ========================================== */

    .users-page {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-soft: #eff6ff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --surface: #ffffff;

        width: 100%;
        min-width: 0;
        color: var(--text-main);
        font-family: Inter, -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
    }

    .users-page *,
    .users-page *::before,
    .users-page *::after {
        box-sizing: border-box;
    }

    /* Fil d'Ariane */

    .users-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 22px;
        font-size: 12px;
    }

    .users-breadcrumb a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        text-decoration: none;
        transition: color .2s ease;
    }

    .users-breadcrumb a:hover {
        color: var(--primary);
    }

    .users-breadcrumb > i {
        color: #cbd5e1;
        font-size: 10px;
    }

    .users-breadcrumb span {
        color: var(--primary);
        font-weight: 600;
    }

    /* En-tête */

    .users-page .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .users-page .page-header h1 {
        margin: 0 0 8px;
        color: var(--text-main);
        font-size: clamp(23px, 2.5vw, 30px);
        font-weight: 750;
        letter-spacing: -.8px;
        line-height: 1.3;
    }

    .users-page .page-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.7;
    }

    /* Bouton principal */

    .users-page .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 18px;
        color: #fff;
        background: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        box-shadow: 0 4px 12px rgba(37, 99, 235, .15);
        cursor: pointer;
        transition: all .2s ease;
    }

    .users-page .btn-primary-custom:hover {
        background: var(--primary-dark);
        border-color: var(--primary-dark);
        box-shadow: 0 7px 18px rgba(37, 99, 235, .22);
        transform: translateY(-1px);
    }

    .users-page .btn-primary-custom i {
        font-size: 17px;
    }

    /* ==========================================
       CARTES STATISTIQUES
    ========================================== */

    .users-page .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .users-page .stat-card {
        min-width: 0;
        padding: 22px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 3px 15px rgba(15, 23, 42, .035);
        transition: transform .2s ease, box-shadow .2s ease,
            border-color .2s ease;
    }

    .users-page .stat-card:hover {
        transform: translateY(-3px);
        border-color: #cbd5e1;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .07);
    }

    .users-page .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
    }

    .users-page .stat-label {
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.6;
    }

    .users-page .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        font-size: 20px;
    }

    .users-page .icon-blue {
        color: #2563eb;
        background: #eff6ff;
    }

    .users-page .icon-green {
        color: #16a34a;
        background: #f0fdf4;
    }

    .users-page .icon-purple {
        color: #7c3aed;
        background: #f5f3ff;
    }

    .users-page .icon-orange {
        color: #ea580c;
        background: #fff7ed;
    }

    .users-page .stat-number {
        margin-bottom: 7px;
        color: var(--text-main);
        font-size: 34px;
        font-weight: 750;
        line-height: 1.2;
        letter-spacing: -1px;
    }

    .users-page .stat-description {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }

    /* ==========================================
       PANNEAU DES UTILISATEURS
    ========================================== */

    .users-page .users-panel {
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 3px 15px rgba(15, 23, 42, .035);
    }

    .users-page .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 22px;
        padding: 24px;
        border-bottom: 1px solid var(--border);
    }

    .users-page .panel-header h2 {
        margin: 0 0 7px;
        color: var(--text-main);
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -.3px;
    }

    .users-page .panel-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.6;
    }

    /* Recherche et filtres */

    .users-page .filter-area {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .users-page .search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 240px;
        min-width: 0;
        padding: 0 12px;
        background: #fff;
        border: 1px solid #dbe2ea;
        border-radius: 9px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .users-page .search-box:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .users-page .search-box > i {
        flex-shrink: 0;
        color: #94a3b8;
        font-size: 14px;
    }

    .users-page .search-box input {
        width: 100%;
        min-width: 0;
        height: 42px;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text-main);
        font-family: inherit;
        font-size: 12px;
    }

    .users-page .search-box input::placeholder {
        color: #94a3b8;
    }

    .users-page .filter-select {
        height: 44px;
        max-width: 100%;
        padding: 0 30px 0 11px;
        color: #334155;
        background-color: #fff;
        border: 1px solid #dbe2ea;
        border-radius: 9px;
        font-family: inherit;
        font-size: 12px;
        cursor: pointer;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .users-page .filter-select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    /* ==========================================
       TABLEAU
    ========================================== */

    .users-page .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .users-page .users-table {
        width: 100%;
        min-width: 950px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        color: #475569;
        font-size: 12px;
    }

    .users-page .users-table thead {
        background: #f8fafc;
    }

    .users-page .users-table thead th {
        padding: 15px 18px;
        color: #64748b;
        text-align: left;
        white-space: nowrap;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .55px;
        border-bottom: 1px solid var(--border);
    }

    .users-page .users-table tbody td {
        padding: 16px 18px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .users-page .users-table tbody tr {
        background: #fff;
        transition: background .18s ease;
    }

    .users-page .users-table tbody tr:hover {
        background: #f8fbff;
    }

    .users-page .users-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Identité */

    .users-page .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 215px;
    }

    .users-page .user-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 50%;
        font-size: 11px;
        font-weight: 750;
    }

    .users-page .user-row:nth-child(4n + 2) .user-avatar {
        color: #047857;
        background: #ecfdf5;
        border-color: #d1fae5;
    }

    .users-page .user-row:nth-child(4n + 3) .user-avatar {
        color: #7c3aed;
        background: #f5f3ff;
        border-color: #ede9fe;
    }

    .users-page .user-row:nth-child(4n + 4) .user-avatar {
        color: #c2410c;
        background: #fff7ed;
        border-color: #ffedd5;
    }

    .users-page .user-name {
        margin-bottom: 5px;
        color: #1e293b;
        font-size: 12px;
        font-weight: 700;
    }

    .users-page .user-email {
        color: #94a3b8;
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    /* Badges des rôles */

    .users-page .role-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        border: 1px solid transparent;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .users-page .role-admin {
        color: #6d28d9;
        background: #f5f3ff;
        border-color: #ede9fe;
    }

    .users-page .role-agent {
        color: #1d4ed8;
        background: #eff6ff;
        border-color: #dbeafe;
    }

    .users-page .role-responsable {
        color: #b45309;
        background: #fffbeb;
        border-color: #fef3c7;
    }

    .users-page .role-service {
        color: #0f766e;
        background: #f0fdfa;
        border-color: #ccfbf1;
    }

    /* Statuts */

    .users-page .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .users-page .status-active {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #dcfce7;
    }

    .users-page .status-inactive {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fee2e2;
    }

    .users-page .status-badge i {
        font-size: 12px;
    }

    /* Actions */

    .users-page .action-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .users-page .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 33px;
        height: 33px;
        padding: 0;
        color: #64748b;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        transition: all .2s ease;
    }

    .users-page .action-btn:hover {
        color: var(--primary);
        background: #eff6ff;
        border-color: #bfdbfe;
        transform: translateY(-1px);
    }

    .users-page .action-btn.delete:hover {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

    /* État vide */

    .users-page .empty-state {
        display: none;
        padding: 45px 20px;
        color: #64748b;
        text-align: center;
        font-size: 13px;
    }

    .users-page .empty-state i {
        color: #94a3b8;
    }

    /* Pied du tableau */

    .users-page .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 17px 24px;
        background: #fff;
        border-top: 1px solid var(--border);
    }

    .users-page #resultCount {
        color: #64748b;
        font-size: 12px;
    }

    .users-page .pagination-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .users-page .pagination-buttons button {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 34px;
        padding: 0 9px;
        color: #64748b;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

    .users-page .pagination-buttons button:hover:not(:disabled):not(.active) {
        color: var(--primary);
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .users-page .pagination-buttons button.active {
        color: #fff;
        background: var(--primary);
        border-color: var(--primary);
    }

    .users-page .pagination-buttons button:disabled {
        color: #cbd5e1;
        background: #f8fafc;
        cursor: not-allowed;
    }

    /* ==========================================
       MODALE D'AJOUT
    ========================================== */

    #addUserModal .modal-content {
        overflow: hidden;
        border: 1px solid #e2e8f0 !important;
        border-radius: 16px !important;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .18);
    }

    #addUserModal .modal-header {
        padding: 22px 24px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    #addUserModal .modal-title {
        color: #0f172a;
        font-size: 18px;
        font-weight: 750;
    }

    #addUserModal .modal-body {
        padding: 24px;
    }

    #addUserModal .form-label {
        margin-bottom: 7px;
        color: #334155;
        font-size: 12px;
        font-weight: 650;
    }

    #addUserModal .form-control,
    #addUserModal .form-select {
        min-height: 43px;
        border: 1px solid #dbe2ea;
        border-radius: 9px;
        font-size: 13px;
        box-shadow: none;
    }

    #addUserModal .form-control:focus,
    #addUserModal .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    #addUserModal .btn-primary {
        min-height: 44px;
        background: #2563eb;
        border-color: #2563eb;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 650;
    }

    #addUserModal .btn-primary:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
    }

    /* ==========================================
       RESPONSIVE
    ========================================== */

    @media (max-width: 1200px) {
        .users-page .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .users-page .panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .users-page .filter-area {
            width: 100%;
        }

        .users-page .search-box {
            flex: 1 1 220px;
        }
    }

    @media (max-width: 768px) {
        .users-page .page-header {
            align-items: stretch;
            flex-direction: column;
            gap: 16px;
        }

        .users-page .page-header h1 {
            font-size: 24px;
        }

        .users-page .btn-primary-custom {
            width: 100%;
        }

        .users-page .stats-grid {
            gap: 12px;
            margin-bottom: 20px;
        }

        .users-page .stat-card {
            padding: 15px;
            border-radius: 12px;
        }

        .users-page .stat-top {
            align-items: flex-start;
            flex-direction: column-reverse;
            gap: 10px;
            margin-bottom: 14px;
        }

        .users-page .stat-icon {
            width: 37px;
            height: 37px;
            font-size: 17px;
        }

        .users-page .stat-label {
            font-size: 11px;
        }

        .users-page .stat-number {
            font-size: 28px;
        }

        .users-page .stat-description {
            font-size: 10px;
        }

        .users-page .panel-header {
            padding: 20px 16px;
        }

        .users-page .filter-area {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }

        .users-page .search-box {
            width: 100%;
        }

        .users-page .filter-select {
            width: 100%;
        }

        .users-page .table-footer {
            align-items: flex-start;
            flex-direction: column;
            padding: 16px;
        }
    }

    @media (max-width: 380px) {
        .users-page .stats-grid {
            grid-template-columns: 1fr;
        }

        .users-page .stat-top {
            align-items: center;
            flex-direction: row;
        }
    }
</style>

<div class="users-page">
    {# Fil d'Ariane #}
    <nav class="users-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/admin/dashboard">
            <i class="bi bi-house-door"></i>
            Tableau de bord
        </a>
        <i class="bi bi-chevron-right"></i>
        <span>Utilisateurs</span>
    </nav>

    {# En-tête de page #}
    <div class="page-header">
        <div>
            <h1>Gestion des utilisateurs</h1>
            <p>Gérez les comptes, les rôles et les accès des utilisateurs du système.</p>
        </div>

        <button type="button"
                class="btn-primary-custom"
                data-bs-toggle="modal"
                data-bs-target="#addUserModal">
            <i class="bi bi-plus-lg"></i>
            Ajouter un utilisateur
        </button>
    </div>

    {# Données de démonstration #}
    {% set utilisateurs = [
        {
            nom: 'Jean Rakoto',
            email: 'jean.rakoto@sgec.mg',
            initiales: 'JR',
            role: 'Administrateur',
            service: 'Administration',
            date: '12/01/2026',
            statut: 'Actif'
        },
        {
            nom: 'Marie Randria',
            email: 'marie.randria@sgec.mg',
            initiales: 'MR',
            role: 'Agent courrier',
            service: 'Courrier central',
            date: '18/02/2026',
            statut: 'Actif'
        },
        {
            nom: 'Paul Andria',
            email: 'paul.andria@sgec.mg',
            initiales: 'PA',
            role: 'Responsable',
            service: 'Direction générale',
            date: '05/03/2026',
            statut: 'Actif'
        },
        {
            nom: 'Sarah Rasoana',
            email: 'sarah.rasoana@sgec.mg',
            initiales: 'SR',
            role: 'Agent de service',
            service: 'Ressources humaines',
            date: '10/04/2026',
            statut: 'Actif'
        },
        {
            nom: 'Hery Rakoto',
            email: 'hery.rakoto@sgec.mg',
            initiales: 'HR',
            role: 'Agent courrier',
            service: 'Courrier central',
            date: '15/05/2026',
            statut: 'Inactif'
        },
        {
            nom: 'Lalao Rabe',
            email: 'lalao.rabe@sgec.mg',
            initiales: 'LR',
            role: 'Agent de service',
            service: 'Comptabilité',
            date: '20/06/2026',
            statut: 'Actif'
        }
    ] %}

    {# Cartes statistiques #}
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Total utilisateurs</span>
                <div class="stat-icon icon-blue">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="stat-number" id="totalUsers">{{ utilisateurs|length }}</div>
            <div class="stat-description">Comptes enregistrés</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Utilisateurs actifs</span>
                <div class="stat-icon icon-green">
                    <i class="bi bi-person-check"></i>
                </div>
            </div>
            <div class="stat-number" id="activeUsers">
                {{ utilisateurs|filter(u => u.statut == 'Actif')|length }}
            </div>
            <div class="stat-description">Comptes opérationnels</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Administrateurs</span>
                <div class="stat-icon icon-purple">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
            <div class="stat-number" id="adminUsers">
                {{ utilisateurs|filter(u => u.role == 'Administrateur')|length }}
            </div>
            <div class="stat-description">Comptes administrateurs</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Comptes inactifs</span>
                <div class="stat-icon icon-orange">
                    <i class="bi bi-person-x"></i>
                </div>
            </div>
            <div class="stat-number" id="inactiveUsers">
                {{ utilisateurs|filter(u => u.statut == 'Inactif')|length }}
            </div>
            <div class="stat-description">Comptes désactivés</div>
        </div>

    </div>

    {# Tableau des utilisateurs #}
    <section class="users-panel">

        <div class="panel-header">
            <div>
                <h2>Liste des utilisateurs</h2>
                <p>Consultez et gérez les comptes enregistrés.</p>
            </div>

            <div class="filter-area">

                <label class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           id="searchUser"
                           placeholder="Rechercher un utilisateur..."
                           aria-label="Rechercher un utilisateur">
                </label>

                <select class="filter-select" id="roleFilter" aria-label="Filtrer par rôle">
                    <option value="">Tous les rôles</option>
                    <option value="Administrateur">Administrateur</option>
                    <option value="Agent courrier">Agent courrier</option>
                    <option value="Responsable">Responsable</option>
                    <option value="Agent de service">Agent de service</option>
                </select>

                <select class="filter-select" id="statusFilter" aria-label="Filtrer par statut">
                    <option value="">Tous les statuts</option>
                    <option value="Actif">Actif</option>
                    <option value="Inactif">Inactif</option>
                </select>

            </div>
        </div>

        <div class="table-responsive">

            <table class="users-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Rôle</th>
                        <th>Service</th>
                        <th>Date de création</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="usersTableBody">

                    {% set roleClass = {
                        'Administrateur': 'role-admin',
                        'Agent courrier': 'role-agent',
                        'Responsable': 'role-responsable',
                        'Agent de service': 'role-service'
                    } %}

                    {% for utilisateur in utilisateurs %}
                        <tr class="user-row"
                            data-name="{{ utilisateur.nom|lower }}"
                            data-email="{{ utilisateur.email|lower }}"
                            data-role="{{ utilisateur.role }}"
                            data-status="{{ utilisateur.statut }}">

                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar">
                                        {{ utilisateur.initiales }}
                                    </div>

                                    <div>
                                        <div class="user-name">
                                            {{ utilisateur.nom }}
                                        </div>
                                        <div class="user-email">
                                            {{ utilisateur.email }}
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="role-badge {{ roleClass[utilisateur.role] }}">
                                    {{ utilisateur.role }}
                                </span>
                            </td>

                            <td>{{ utilisateur.service }}</td>
                            <td>{{ utilisateur.date }}</td>

                            <td>
                                <span class="status-badge {{ utilisateur.statut == 'Actif' ? 'status-active' : 'status-inactive' }}">
                                    <i class="bi {{ utilisateur.statut == 'Actif' ? 'bi-check-circle' : 'bi-x-circle' }}"></i>
                                    {{ utilisateur.statut }}
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <button type="button"
                                            class="action-btn"
                                            title="Voir le profil"
                                            aria-label="Voir le profil de {{ utilisateur.nom }}"
                                            onclick="showUser('{{ utilisateur.nom|e('js') }}')">
                                        <i class="bi bi-eye"></i>
                                    </button>

                                    <button type="button"
                                            class="action-btn"
                                            title="Modifier"
                                            aria-label="Modifier {{ utilisateur.nom }}"
                                            onclick="editUser('{{ utilisateur.nom|e('js') }}')">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Supprimer"
                                            aria-label="Supprimer {{ utilisateur.nom }}"
                                            onclick="deleteUser(this, '{{ utilisateur.nom|e('js') }}')">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>
                            </td>

                        </tr>
                    {% endfor %}

                </tbody>
            </table>

            <div id="emptyState" class="empty-state">
                <i class="bi bi-search fs-3 d-block mb-3"></i>
                <strong>Aucun utilisateur trouvé</strong>
                <p class="mb-0 mt-2">
                    Modifiez les critères de recherche ou les filtres.
                </p>
            </div>

        </div>

        <div class="table-footer">
            <span id="resultCount">
                Affichage de {{ utilisateurs|length }} utilisateurs
            </span>

            <div class="pagination-buttons">
                <button type="button" aria-label="Page précédente" disabled>
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="active" aria-current="page">1</button>
                <button type="button" aria-label="Page suivante" disabled>
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

    </section>

</div>

{# ==========================================
   MODALE D'AJOUT D'UTILISATEUR
========================================== #}

<div class="modal fade"
     id="addUserModal"
     tabindex="-1"
     aria-labelledby="addUserModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="addUserModalLabel">
                        Ajouter un utilisateur
                    </h5>
                    <small class="text-secondary">
                        Renseignez les informations du compte.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer">
                </button>
            </div>

            <div class="modal-body">

                <form id="addUserForm">

                    <div class="mb-3">
                        <label for="newName" class="form-label">
                            Nom complet
                        </label>
                        <input type="text"
                               class="form-control"
                               id="newName"
                               placeholder="Ex. : Jean Rakoto"
                               autocomplete="name"
                               required>
                    </div>

                    <div class="mb-3">
                        <label for="newEmail" class="form-label">
                            Adresse e-mail
                        </label>
                        <input type="email"
                               class="form-control"
                               id="newEmail"
                               placeholder="nom@sgec.mg"
                               autocomplete="email"
                               required>
                    </div>

                    <div class="mb-3">
                        <label for="newRole" class="form-label">Rôle</label>
                        <select class="form-select" id="newRole" required>
                            <option value="">Choisir un rôle</option>
                            <option value="Administrateur">Administrateur</option>
                            <option value="Agent courrier">Agent courrier</option>
                            <option value="Responsable">Responsable</option>
                            <option value="Agent de service">Agent de service</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="newService" class="form-label">
                            Service
                        </label>
                        <input type="text"
                               class="form-control"
                               id="newService"
                               placeholder="Ex. : Administration"
                               required>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-light border w-50"
                                data-bs-dismiss="modal">
                            Annuler
                        </button>

                        <button type="submit" class="btn btn-primary w-50">
                            <i class="bi bi-plus-lg me-1"></i>
                            Ajouter
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

{# ==========================================
   JAVASCRIPT
========================================== #}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchUser');
    const roleFilter = document.getElementById('roleFilter');
    const statusFilter = document.getElementById('statusFilter');
    const tableBody = document.getElementById('usersTableBody');
    const emptyState = document.getElementById('emptyState');
    const resultCount = document.getElementById('resultCount');

    /*
     * Recherche et filtres
     */
    function filterUsers() {
        const search = searchInput.value.toLocaleLowerCase().trim();
        const role = roleFilter.value;
        const status = statusFilter.value;
        const rows = [...tableBody.querySelectorAll('.user-row')];

        let visibleCount = 0;

        rows.forEach(function (row) {
            const name = row.dataset.name || '';
            const email = row.dataset.email || '';
            const service = row.cells[2]?.textContent.toLocaleLowerCase().trim() || '';

            const matchesSearch =
                name.includes(search) ||
                email.includes(search) ||
                service.includes(search);

            const matchesRole = !role || row.dataset.role === role;
            const matchesStatus = !status || row.dataset.status === status;

            const visible = matchesSearch && matchesRole && matchesStatus;

            row.style.display = visible ? '' : 'none';

            if (visible) {
                visibleCount++;
            }
        });

        resultCount.textContent =
            'Affichage de ' + visibleCount +
            ' utilisateur' + (visibleCount > 1 ? 's' : '');

        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    searchInput.addEventListener('input', filterUsers);
    roleFilter.addEventListener('change', filterUsers);
    statusFilter.addEventListener('change', filterUsers);

    /*
     * Statistiques calculées à partir des lignes présentes
     */
    function updateStats() {
        const rows = [...tableBody.querySelectorAll('.user-row')];

        const active = rows.filter(
            row => row.dataset.status === 'Actif'
        ).length;

        const inactive = rows.filter(
            row => row.dataset.status === 'Inactif'
        ).length;

        const admins = rows.filter(
            row => row.dataset.role === 'Administrateur'
        ).length;

        document.getElementById('totalUsers').textContent = rows.length;
        document.getElementById('activeUsers').textContent = active;
        document.getElementById('inactiveUsers').textContent = inactive;
        document.getElementById('adminUsers').textContent = admins;
    }

    /*
     * Consultation de démonstration
     */
    window.showUser = function (name) {
        alert(
            'Profil utilisateur : ' + name +
            '\n\nLa consultation détaillée sera reliée au backend Symfony.'
        );
    };

    /*
     * Modification de démonstration
     */
    window.editUser = function (name) {
        alert(
            'Modification de : ' + name +
            '\n\nLe formulaire de modification sera relié au backend Symfony.'
        );
    };

    /*
     * Suppression de la ligne de démonstration
     */
    window.deleteUser = function (button, name) {
        if (!confirm(
            'Voulez-vous retirer ' + name +
            ' du tableau de démonstration ?'
        )) {
            return;
        }

        button.closest('tr').remove();

        filterUsers();
        updateStats();
    };

    /*
     * Ajout visuel de démonstration
     *
     * Cette opération modifie uniquement le tableau dans le navigateur.
     * Elle ne crée pas de compte dans la base de données.
     */
    document.getElementById('addUserForm').addEventListener(
        'submit',
        function (event) {
            event.preventDefault();

            const name = document.getElementById('newName').value.trim();
            const email = document.getElementById('newEmail').value.trim();
            const role = document.getElementById('newRole').value;
            const service = document.getElementById('newService').value.trim();

            if (!name || !email || !role || !service) {
                return;
            }

            const duplicate = [...tableBody.querySelectorAll('.user-row')]
                .some(row => row.dataset.email === email.toLocaleLowerCase());

            if (duplicate) {
                alert('Cette adresse e-mail existe déjà dans le tableau.');
                return;
            }

            const initials = name
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map(part => part.charAt(0).toLocaleUpperCase())
                .join('');

            const roleClasses = {
                'Administrateur': 'role-admin',
                'Agent courrier': 'role-agent',
                'Responsable': 'role-responsable',
                'Agent de service': 'role-service'
            };

            const row = document.createElement('tr');
            row.className = 'user-row';

            row.dataset.name = name.toLocaleLowerCase();
            row.dataset.email = email.toLocaleLowerCase();
            row.dataset.role = role;
            row.dataset.status = 'Actif';

            /*
             * Création des cellules avec textContent afin de ne pas
             * interpréter les données saisies comme du code HTML.
             */
            const identityCell = document.createElement('td');
            const userCell = document.createElement('div');
            userCell.className = 'user-cell';

            const avatar = document.createElement('div');
            avatar.className = 'user-avatar';
            avatar.textContent = initials;

            const identity = document.createElement('div');

            const userName = document.createElement('div');
            userName.className = 'user-name';
            userName.textContent = name;

            const userEmail = document.createElement('div');
            userEmail.className = 'user-email';
            userEmail.textContent = email;

            identity.append(userName, userEmail);
            userCell.append(avatar, identity);
            identityCell.append(userCell);

            const roleCell = document.createElement('td');
            const roleBadge = document.createElement('span');
            roleBadge.className = 'role-badge ' + (roleClasses[role] || '');
            roleBadge.textContent = role;
            roleCell.append(roleBadge);

            const serviceCell = document.createElement('td');
            serviceCell.textContent = service;

            const dateCell = document.createElement('td');
            dateCell.textContent = new Intl.DateTimeFormat('fr-FR')
                .format(new Date());

            const statusCell = document.createElement('td');
            const statusBadge = document.createElement('span');
            statusBadge.className = 'status-badge status-active';

            const statusIcon = document.createElement('i');
            statusIcon.className = 'bi bi-check-circle';

            statusBadge.append(statusIcon, document.createTextNode(' Actif'));
            statusCell.append(statusBadge);

            const actionsCell = document.createElement('td');
            const actions = document.createElement('div');
            actions.className = 'action-buttons';

            [
                {icon: 'bi-eye', title: 'Voir le profil', action: 'view'},
                {icon: 'bi-pencil', title: 'Modifier', action: 'edit'},
                {icon: 'bi-trash', title: 'Supprimer', action: 'delete'}
            ].forEach(function (item) {
                const button = document.createElement('button');

                button.type = 'button';
                button.className = 'action-btn' +
                    (item.action === 'delete' ? ' delete' : '');
                button.title = item.title;
                button.setAttribute('aria-label', item.title);

                const icon = document.createElement('i');
                icon.className = 'bi ' + item.icon;
                button.append(icon);

                if (item.action === 'view') {
                    button.addEventListener('click', function () {
                        window.showUser(name);
                    });
                }

                if (item.action === 'edit') {
                    button.addEventListener('click', function () {
                        window.editUser(name);
                    });
                }

                if (item.action === 'delete') {
                    button.addEventListener('click', function () {
                        window.deleteUser(button, name);
                    });
                }

                actions.append(button);
            });

            actionsCell.append(actions);
            row.append(
                identityCell,
                roleCell,
                serviceCell,
                dateCell,
                statusCell,
                actionsCell
            );

            tableBody.append(row);

            updateStats();
            filterUsers();

            const modalElement = document.getElementById('addUserModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElement);

            if (modalInstance) {
                modalInstance.hide();
            }

            this.reset();
        }
    );

    updateStats();
    filterUsers();
});
</script>

{% endblock %}