{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Administration - SGEC' %}
{% set pageHeading = 'Gestion des services' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historiques'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Gestion des services | SGEC{% endblock %}

{% block dashboard_content %}

<style>
    .services-page {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --text: #172033;
        --muted: #64748b;
        --border: #e5eaf2;
        color: var(--text);
    }

    .services-page * {
        box-sizing: border-box;
    }

    .services-page .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .services-page .page-title {
        margin: 0 0 7px;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .services-page .page-subtitle {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .services-page .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 17px;
        color: #fff;
        background: var(--primary);
        border: 0;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 5px 12px rgba(37, 99, 235, .16);
        transition: .2s;
    }

    .services-page .btn-primary-custom:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
    }

    .services-page .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 26px;
    }

    .services-page .stat-card {
        padding: 22px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
    }

    .services-page .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 18px;
    }

    .services-page .stat-label {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
    }

    .services-page .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 12px;
        font-size: 19px;
    }

    .services-page .icon-blue {
        color: #2563eb;
        background: #eff6ff;
    }

    .services-page .icon-green {
        color: #059669;
        background: #ecfdf5;
    }

    .services-page .icon-orange {
        color: #d97706;
        background: #fffbeb;
    }

    .services-page .stat-number {
        display: block;
        margin-bottom: 6px;
        font-size: 30px;
        font-weight: 750;
        line-height: 1.2;
    }

    .services-page .stat-description {
        color: var(--muted);
        font-size: 12px;
    }

    .services-page .services-panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 15px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
    }

    .services-page .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 23px 24px;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .services-page .panel-title {
        margin: 0 0 5px;
        font-size: 17px;
        font-weight: 700;
    }

    .services-page .panel-description {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .services-page .filter-area {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .services-page .search-box {
        position: relative;
        min-width: 230px;
    }

    .services-page .search-box i {
        position: absolute;
        top: 50%;
        left: 13px;
        color: #94a3b8;
        transform: translateY(-50%);
    }

    .services-page .search-box input,
    .services-page .filter-select {
        height: 42px;
        padding: 0 13px;
        color: #334155;
        background: #fff;
        border: 1px solid #dfe5ee;
        border-radius: 9px;
        outline: none;
        font-size: 13px;
    }

    .services-page .search-box input {
        width: 100%;
        padding-left: 37px;
    }

    .services-page .search-box input:focus,
    .services-page .filter-select:focus,
    .services-page .form-control:focus {
        border-color: #93b4fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .services-page .table-responsive {
        overflow-x: auto;
    }

    .services-page .services-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .services-page .services-table thead th {
        padding: 15px 24px;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid var(--border);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .services-page .services-table tbody td {
        padding: 17px 24px;
        border-bottom: 1px solid #edf1f6;
        vertical-align: middle;
        font-size: 13px;
    }

    .services-page .services-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .services-page .services-table tbody tr:hover {
        background: #f8fbff;
    }

    .services-page .service-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .services-page .service-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        color: #2563eb;
        background: #eff6ff;
        border-radius: 11px;
        font-size: 19px;
    }

    .services-page .service-name {
        margin-bottom: 4px;
        color: #172033;
        font-weight: 700;
    }

    .services-page .service-description {
        max-width: 300px;
        overflow: hidden;
        color: #64748b;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .services-page .service-code {
        color: #64748b;
        font-size: 12px;
    }

    .services-page .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .services-page .status-badge::before {
        width: 6px;
        height: 6px;
        background: currentColor;
        border-radius: 50%;
        content: "";
    }

    .services-page .status-active {
        color: #047857;
        background: #ecfdf5;
    }

    .services-page .status-inactive {
        color: #b45309;
        background: #fffbeb;
    }

    .services-page .action-buttons {
        display: flex;
        gap: 7px;
    }

    .services-page .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        color: #64748b;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        cursor: pointer;
        transition: .2s;
    }

    .services-page .action-btn:hover {
        color: #2563eb;
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .services-page .action-btn.delete:hover {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

    .services-page .empty-state {
        display: none;
        padding: 42px 20px;
        color: #64748b;
        text-align: center;
    }

    .services-page .empty-state.show {
        display: block;
    }

    .services-page .empty-state i {
        display: block;
        margin-bottom: 12px;
        color: #94a3b8;
        font-size: 34px;
    }

    .services-page .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 17px 24px;
        border-top: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .services-page .result-count {
        color: #64748b;
        font-size: 12px;
    }

    .services-page .pagination-buttons {
        display: flex;
        gap: 6px;
    }

    .services-page .pagination-buttons button {
        width: 33px;
        height: 33px;
        color: #64748b;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    .services-page .pagination-buttons button.active {
        color: #fff;
        background: var(--primary);
        border-color: var(--primary);
    }

    .services-page .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(15, 23, 42, .15);
    }

    .services-page .modal-header {
        padding: 21px 24px;
        border-bottom: 1px solid var(--border);
    }

    .services-page .modal-title {
        font-size: 18px;
        font-weight: 700;
    }

    .services-page .modal-body {
        padding: 24px;
    }

    .services-page .form-label {
        margin-bottom: 7px;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .services-page .form-control,
    .services-page .form-select {
        min-height: 43px;
        border-color: #dfe5ee;
        border-radius: 9px;
        font-size: 13px;
    }

    .services-page textarea.form-control {
        min-height: 95px;
    }

    @media (max-width: 900px) {
        .services-page .stats-grid {
            grid-template-columns: 1fr;
        }

        .services-page .panel-header {
            align-items: flex-start;
        }

        .services-page .filter-area {
            width: 100%;
        }

        .services-page .search-box {
            flex: 1;
            min-width: 180px;
        }
    }

    @media (max-width: 576px) {
        .services-page .page-title {
            font-size: 23px;
        }

        .services-page .page-header > .btn-primary-custom {
            width: 100%;
        }

        .services-page .panel-header,
        .services-page .table-footer {
            padding: 17px;
        }

        .services-page .filter-area {
            flex-direction: column;
        }

        .services-page .search-box,
        .services-page .filter-select {
            width: 100%;
        }
    }
</style>

<div class="services-page">

    {# En-tête #}
    <div class="page-header">
        <div>
            <h1 class="page-title">Gestion des services</h1>
            <p class="page-subtitle">
                Gérez les services administratifs et leur disponibilité.
            </p>
        </div>

        <button type="button"
                class="btn-primary-custom"
                data-bs-toggle="modal"
                data-bs-target="#addServiceModal">
            <i class="bi bi-plus-lg"></i>
            Ajouter un service
        </button>
    </div>

    {# Statistiques #}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Total des services</span>
                <span class="stat-icon icon-blue">
                    <i class="bi bi-building"></i>
                </span>
            </div>
            <span class="stat-number" id="totalServices">5</span>
            <span class="stat-description">Services enregistrés</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Services actifs</span>
                <span class="stat-icon icon-green">
                    <i class="bi bi-check-circle"></i>
                </span>
            </div>
            <span class="stat-number" id="activeServices">4</span>
            <span class="stat-description">Services disponibles</span>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-label">Services inactifs</span>
                <span class="stat-icon icon-orange">
                    <i class="bi bi-pause-circle"></i>
                </span>
            </div>
            <span class="stat-number" id="inactiveServices">1</span>
            <span class="stat-description">Services désactivés</span>
        </div>
    </div>

    {# Tableau des services #}
    <section class="services-panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title">Liste des services</h2>
                <p class="panel-description">
                    Consultez et gérez les services de votre organisation.
                </p>
            </div>

            <div class="filter-area">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           id="searchService"
                           placeholder="Rechercher un service..."
                           aria-label="Rechercher un service">
                </div>

                <select id="statusFilter"
                        class="filter-select"
                        aria-label="Filtrer par statut">
                    <option value="">Tous les statuts</option>
                    <option value="active">Actif</option>
                    <option value="inactive">Inactif</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="services-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Responsable</th>
                        <th>Courriel</th>
                        <th>Statut</th>
                        <th>Date de création</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="servicesTableBody">
                    {% set services = [
                        {
                            id: 1,
                            nom: 'Ressources humaines',
                            description: 'Gestion du personnel et des ressources humaines',
                            responsable: 'Direction RH',
                            email: 'rh@sgec.mg',
                            statut: 'active',
                            date: '12/01/2026',
                            icon: 'bi-people'
                        },
                        {
                            id: 2,
                            nom: 'Comptabilité et finances',
                            description: 'Gestion financière et comptable',
                            responsable: 'Service financier',
                            email: 'finance@sgec.mg',
                            statut: 'active',
                            date: '15/01/2026',
                            icon: 'bi-cash-stack'
                        },
                        {
                            id: 3,
                            nom: 'Informatique',
                            description: 'Support technique et gestion informatique',
                            responsable: 'Direction informatique',
                            email: 'informatique@sgec.mg',
                            statut: 'active',
                            date: '20/01/2026',
                            icon: 'bi-pc-display'
                        },
                        {
                            id: 4,
                            nom: 'Affaires générales',
                            description: 'Gestion administrative générale',
                            responsable: 'Secrétariat général',
                            email: 'secretariat@sgec.mg',
                            statut: 'active',
                            date: '02/02/2026',
                            icon: 'bi-briefcase'
                        },
                        {
                            id: 5,
                            nom: 'Archives',
                            description: 'Classement et conservation des documents',
                            responsable: 'Service des archives',
                            email: 'archives@sgec.mg',
                            statut: 'inactive',
                            date: '10/02/2026',
                            icon: 'bi-archive'
                        }
                    ] %}

                    {% for service in services %}
                        <tr class="service-row"
                            data-id="{{ service.id }}"
                            data-name="{{ service.nom|lower }}"
                            data-status="{{ service.statut }}">

                            <td>
                                <div class="service-info">
                                    <div class="service-avatar">
                                        <i class="bi {{ service.icon }}"></i>
                                    </div>
                                    <div>
                                        <div class="service-name">
                                            {{ service.nom }}
                                        </div>
                                        <div class="service-description">
                                            {{ service.description }}
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>{{ service.responsable }}</td>
                            <td>{{ service.email }}</td>

                            <td>
                                {% if service.statut == 'active' %}
                                    <span class="status-badge status-active">
                                        Actif
                                    </span>
                                {% else %}
                                    <span class="status-badge status-inactive">
                                        Inactif
                                    </span>
                                {% endif %}
                            </td>

                            <td>{{ service.date }}</td>

                            <td>
                                <div class="action-buttons">
                                    <button type="button"
                                            class="action-btn"
                                            title="Modifier"
                                            aria-label="Modifier {{ service.nom }}"
                                            onclick="editService(this)"
                                            data-id="{{ service.id }}"
                                            data-name="{{ service.nom }}"
                                            data-description="{{ service.description }}"
                                            data-responsable="{{ service.responsable }}"
                                            data-email="{{ service.email }}"
                                            data-status="{{ service.statut }}">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button type="button"
                                            class="action-btn delete"
                                            title="Supprimer"
                                            aria-label="Supprimer {{ service.nom }}"
                                            onclick="deleteService(this)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="empty-state" id="emptyStateServices">
            <i class="bi bi-search"></i>
            <strong>Aucun service trouvé</strong>
            <p class="mb-0 mt-2">
                Essayez de modifier votre recherche ou votre filtre.
            </p>
        </div>

        <div class="table-footer">
            <span class="result-count" id="resultCountServices">
                Affichage de 5 services
            </span>

            <div class="pagination-buttons">
                <button type="button" aria-label="Page précédente" disabled>
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" class="active" aria-current="page">1</button>
                <button type="button" aria-label="Page suivante" disabled>
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </section>
</div>

{# Modal d'ajout #}
<div class="modal fade" id="addServiceModal" tabindex="-1"
     aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="addServiceModalLabel">
                        Ajouter un service
                    </h5>
                    <p class="text-secondary small mb-0 mt-1">
                        Renseignez les informations du nouveau service.
                    </p>
                </div>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <form id="addServiceForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="serviceName" class="form-label">
                            Nom du service *
                        </label>
                        <input type="text" class="form-control"
                               id="serviceName" required
                               placeholder="Ex. : Service juridique">
                    </div>

                    <div class="mb-3">
                        <label for="serviceDescription" class="form-label">
                            Description
                        </label>
                        <textarea class="form-control"
                                  id="serviceDescription"
                                  placeholder="Description du service"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="serviceResponsable" class="form-label">
                            Responsable *
                        </label>
                        <input type="text" class="form-control"
                               id="serviceResponsable" required
                               placeholder="Nom du responsable">
                    </div>

                    <div class="mb-3">
                        <label for="serviceEmail" class="form-label">
                            Adresse courriel *
                        </label>
                        <input type="email" class="form-control"
                               id="serviceEmail" required
                               placeholder="service@sgec.mg">
                    </div>

                    <div>
                        <label for="serviceStatus" class="form-label">
                            Statut
                        </label>
                        <select class="form-select" id="serviceStatus">
                            <option value="active">Actif</option>
                            <option value="inactive">Inactif</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Ajouter le service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{# Modal de modification #}
<div class="modal fade" id="editServiceModal" tabindex="-1"
     aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editServiceModalLabel">
                    Modifier le service
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <form id="editServiceForm">
                <div class="modal-body">
                    <input type="hidden" id="editServiceId">

                    <div class="mb-3">
                        <label for="editServiceName" class="form-label">
                            Nom du service *
                        </label>
                        <input type="text" class="form-control"
                               id="editServiceName" required>
                    </div>

                    <div class="mb-3">
                        <label for="editServiceDescription" class="form-label">
                            Description
                        </label>
                        <textarea class="form-control"
                                  id="editServiceDescription"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editServiceResponsable" class="form-label">
                            Responsable *
                        </label>
                        <input type="text" class="form-control"
                               id="editServiceResponsable" required>
                    </div>

                    <div class="mb-3">
                        <label for="editServiceEmail" class="form-label">
                            Adresse courriel *
                        </label>
                        <input type="email" class="form-control"
                               id="editServiceEmail" required>
                    </div>

                    <div>
                        <label for="editServiceStatus" class="form-label">
                            Statut
                        </label>
                        <select class="form-select" id="editServiceStatus">
                            <option value="active">Actif</option>
                            <option value="inactive">Inactif</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">
                        Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tableBody = document.getElementById('servicesTableBody');
        const searchInput = document.getElementById('searchService');
        const statusFilter = document.getElementById('statusFilter');
        const emptyState = document.getElementById('emptyStateServices');
        const resultCount = document.getElementById('resultCountServices');

        function updateStatistics() {
            const rows = [...tableBody.querySelectorAll('.service-row')];

            document.getElementById('totalServices').textContent = rows.length;
            document.getElementById('activeServices').textContent =
                rows.filter(row => row.dataset.status === 'active').length;
            document.getElementById('inactiveServices').textContent =
                rows.filter(row => row.dataset.status === 'inactive').length;
        }

        function filterServices() {
            const search = searchInput.value.trim().toLocaleLowerCase();
            const status = statusFilter.value;
            const rows = [...tableBody.querySelectorAll('.service-row')];
            let visible = 0;

            rows.forEach(row => {
                const matchesName = row.dataset.name.includes(search);
                const matchesStatus = !status || row.dataset.status === status;
                const matches = matchesName && matchesStatus;

                row.hidden = !matches;

                if (matches) {
                    visible++;
                }
            });

            emptyState.classList.toggle('show', visible === 0);
            resultCount.textContent =
                `Affichage de ${visible} service${visible > 1 ? 's' : ''}`;
        }

        searchInput.addEventListener('input', filterServices);
        statusFilter.addEventListener('change', filterServices);

        function createCell(text, className = '') {
            const td = document.createElement('td');
            td.textContent = text;
            if (className) td.className = className;
            return td;
        }

        function buildRow(service) {
            const tr = document.createElement('tr');
            tr.className = 'service-row';
            tr.dataset.id = service.id;
            tr.dataset.name = service.nom.toLocaleLowerCase();
            tr.dataset.status = service.statut;

            const infoCell = document.createElement('td');
            const info = document.createElement('div');
            info.className = 'service-info';

            const avatar = document.createElement('div');
            avatar.className = 'service-avatar';

            const icon = document.createElement('i');
            icon.className = 'bi bi-building';
            avatar.appendChild(icon);

            const details = document.createElement('div');
            const name = document.createElement('div');
            name.className = 'service-name';
            name.textContent = service.nom;

            const description = document.createElement('div');
            description.className = 'service-description';
            description.textContent = service.description || 'Aucune description';

            details.append(name, description);
            info.append(avatar, details);
            infoCell.appendChild(info);

            const statusCell = document.createElement('td');
            const statusBadge = document.createElement('span');
            statusBadge.className = 'status-badge ' +
                (service.statut === 'active' ? 'status-active' : 'status-inactive');
            statusBadge.textContent =
                service.statut === 'active' ? 'Actif' : 'Inactif';
            statusCell.appendChild(statusBadge);

            const actionsCell = document.createElement('td');
            const actions = document.createElement('div');
            actions.className = 'action-buttons';

            const editButton = document.createElement('button');
            editButton.type = 'button';
            editButton.className = 'action-btn';
            editButton.title = 'Modifier';
            editButton.setAttribute('aria-label', 'Modifier ' + service.nom);
            editButton.innerHTML = '<i class="bi bi-pencil"></i>';

            Object.entries({
                id: service.id,
                name: service.nom,
                description: service.description,
                responsable: service.responsable,
                email: service.email,
                status: service.statut
            }).forEach(([key, value]) => {
                editButton.dataset[key] = value ?? '';
            });

            editButton.addEventListener('click', () => editService(editButton));

            const deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'action-btn delete';
            deleteButton.title = 'Supprimer';
            deleteButton.setAttribute('aria-label', 'Supprimer ' + service.nom);
            deleteButton.innerHTML = '<i class="bi bi-trash3"></i>';
            deleteButton.addEventListener('click', () => deleteService(deleteButton));

            actions.append(editButton, deleteButton);
            actionsCell.appendChild(actions);

            tr.append(
                infoCell,
                createCell(service.responsable),
                createCell(service.email),
                statusCell,
                createCell(new Date().toLocaleDateString('fr-FR')),
                actionsCell
            );

            return tr;
        }

        document.getElementById('addServiceForm').addEventListener('submit', function (event) {
            event.preventDefault();

            const service = {
                id: Date.now(),
                nom: document.getElementById('serviceName').value.trim(),
                description: document.getElementById('serviceDescription').value.trim(),
                responsable: document.getElementById('serviceResponsable').value.trim(),
                email: document.getElementById('serviceEmail').value.trim(),
                statut: document.getElementById('serviceStatus').value
            };

            if (!service.nom || !service.responsable || !service.email) return;

            tableBody.appendChild(buildRow(service));

            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('addServiceModal')
            ).hide();

            this.reset();
            updateStatistics();
            filterServices();
        });

        window.editService = function (button) {
            document.getElementById('editServiceId').value = button.dataset.id;
            document.getElementById('editServiceName').value = button.dataset.name;
            document.getElementById('editServiceDescription').value =
                button.dataset.description || '';
            document.getElementById('editServiceResponsable').value =
                button.dataset.responsable || '';
            document.getElementById('editServiceEmail').value =
                button.dataset.email || '';
            document.getElementById('editServiceStatus').value =
                button.dataset.status;

            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('editServiceModal')
            ).show();
        };

        document.getElementById('editServiceForm').addEventListener('submit', function (event) {
            event.preventDefault();

            const id = document.getElementById('editServiceId').value;
            const row = tableBody.querySelector(
                `.service-row[data-id="${CSS.escape(id)}"]`
            );

            if (!row) return;

            const nom = document.getElementById('editServiceName').value.trim();
            const description =
                document.getElementById('editServiceDescription').value.trim();
            const responsable =
                document.getElementById('editServiceResponsable').value.trim();
            const email = document.getElementById('editServiceEmail').value.trim();
            const statut = document.getElementById('editServiceStatus').value;

            row.querySelector('.service-name').textContent = nom;
            row.querySelector('.service-description').textContent =
                description || 'Aucune description';

            row.cells[1].textContent = responsable;
            row.cells[2].textContent = email;
            row.dataset.name = nom.toLocaleLowerCase();
            row.dataset.status = statut;

            const badge = row.querySelector('.status-badge');
            badge.className = 'status-badge ' +
                (statut === 'active' ? 'status-active' : 'status-inactive');
            badge.textContent = statut === 'active' ? 'Actif' : 'Inactif';

            const button = row.querySelector('.action-btn:not(.delete)');
            Object.assign(button.dataset, {
                name: nom,
                description: description,
                responsable: responsable,
                email: email,
                status: statut
            });

            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('editServiceModal')
            ).hide();

            updateStatistics();
            filterServices();
        });

        window.deleteService = function (button) {
            const row = button.closest('.service-row');
            const nom = row.querySelector('.service-name').textContent;

            if (!confirm(`Voulez-vous vraiment supprimer le service « ${nom} » ?`)) {
                return;
            }

            row.remove();
            updateStatistics();
            filterServices();
        };

        updateStatistics();
        filterServices();
    });
</script>

{% endblock %}