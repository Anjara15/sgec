                                <button type="button" title="Supprimer" aria-label="Supprimer CR-2026-003" onclick="deleteCourier(this)"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>

                    <tr data-type="Entrant" data-status="Traité" data-service="Informatique">
                        <td><span class="mail-reference">CR-2026-004</span></td>
                        <td>
                            <div class="mail-subject">Demande d'assistance technique</div>
                            <div class="mail-subject-note">Demande de service</div>
                        </td>
                        <td><span class="mail-type type-in"><i class="bi bi-arrow-down-left"></i> Entrant</span></td>
                        <td>
                            <div class="mail-person">Service administratif</div>
                            <div class="mail-subject-note">Interne</div>
                        </td>
                        <td>Informatique</td>
                        <td>25/10/2026</td>
                        <td><span class="mail-status status-done"><span></span> Traité</span></td>
                        <td>
                            <div class="mail-row-actions">
                                <button type="button" title="Consulter" aria-label="Consulter CR-2026-004" onclick="viewCourier(this)"><i class="bi bi-eye"></i></button>
                                <button type="button" title="Modifier" aria-label="Modifier CR-2026-004" onclick="editCourier(this)"><i class="bi bi-pencil"></i></button>
                                <button type="button" title="Supprimer" aria-label="Supprimer CR-2026-004" onclick="deleteCourier(this)"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>

                    <tr data-type="Sortant" data-status="En cours" data-service="Direction générale">
                        <td><span class="mail-reference">CR-2026-005</span></td>
                        <td>
                            <div class="mail-subject">Convocation à une réunion</div>
                            <div class="mail-subject-note">Correspondance officielle</div>
                        </td>
                        <td><span class="mail-type type-out"><i class="bi bi-arrow-up-right"></i> Sortant</span></td>
                        <td>
                            <div class="mail-person">Responsables des services</div>
                            <div class="mail-subject-note">Interne</div>
                        </td>
                        <td>Direction générale</td>
                        <td>24/10/2026</td>
                        <td><span class="mail-status status-progress"><span></span> En cours</span></td>
                        <td>
                            <div class="mail-row-actions">
                                <button type="button" title="Consulter" aria-label="Consulter CR-2026-005" onclick="viewCourier(this)"><i class="bi bi-eye"></i></button>
                                <button type="button" title="Modifier" aria-label="Modifier CR-2026-005" onclick="editCourier(this)"><i class="bi bi-pencil"></i></button>
                                <button type="button" title="Supprimer" aria-label="Supprimer CR-2026-005" onclick="deleteCourier(this)"><i class="bi bi-trash3"></i></button>
                            </div>
