 {# templates/admin/courriers.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Tous les courriers - SGEC' %}
{% set pageHeading = 'Gestion des courriers' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers', active: true},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historiques'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Tous les courriers | SGEC{% endblock %}

{% block dashboard_content %}
<div class="mail-page">
{}
    {# En-tête #}
    <div class="mail-header">
        <div>
            <div class="mail-eyebrow">
                <i class="bi bi-envelope-paper"></i>
                GESTION DOCUMENTAIRE
            </div>
            <h1>Tous les courriers</h1>
            <p>Centralisez, suivez et gérez les courriers entrants et sortants.</p>
        </div>

        <div class="mail-header-actions">
            <button type="button" class="mail-btn mail-btn-light" onclick="exportCourriers()">
                <i class="bi bi-download"></i>
                Exporter
            </button>
            <button type="button" class="mail-btn mail-btn-primary" onclick="openCourierModal()">
                <i class="bi bi-plus-lg"></i>
                Nouveau courrier
            </button>
        </div>
    </div>

    {# Statistiques #}
    <div class="mail-stats">
        <div class="mail-stat-card">
            <div class="mail-stat-icon stat-blue">
                <i class="bi bi-envelope"></i>
            </div>
            <div>
                <span class="mail-stat-label">Total des courriers</span>
                <h2 id="totalCourriers">248</h2>
                <span class="mail-stat-note">Tous les courriers enregistrés</span>
            </div>
        </div>

        <div class="mail-stat-card">
            <div class="mail-stat-icon stat-orange">
                <i class="bi bi-inbox"></i>
            </div>
            <div>
                <span class="mail-stat-label">Courriers entrants</span>
                <h2>142</h2>
                <span class="mail-stat-note">Documents reçus</span>
            </div>
        </div>

        <div class="mail-stat-card">
            <div class="mail-stat-icon stat-purple">
                <i class="bi bi-send"></i>
            </div>
            <div>
                <span class="mail-stat-label">Courriers sortants</span>
                <h2>106</h2>
                <span class="mail-stat-note">Documents envoyés</span>
            </div>
        </div>

        <div class="mail-stat-card">
            <div class="mail-stat-icon stat-green">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <span class="mail-stat-label">Traités</span>
                <h2>186</h2>
                <span class="mail-stat-note">Courriers finalisés</span>
            </div>
        </div>
    </div>

    {# Répartition rapide #}
    <div class="mail-overview">
        <div class="mail-overview-heading">
            <div>
                <h3>Suivi des courriers</h3>
                <p>Vue d'ensemble de l'état de traitement</p>
            </div>
            <span class="mail-overview-period">
                <i class="bi bi-calendar3"></i>
                Vue générale
            </span>
        </div>

        <div class="mail-progress-list">
            <div class="mail-progress-item">
                <div class="mail-progress-info">
                    <span><span class="progress-dot dot-green"></span> Traités</span>
                    <strong>186 <small>(75 %)</small></strong>
                </div>
                <div class="mail-progress-track">
                    <div class="mail-progress-bar bar-green" style="width: 75%"></div>
                </div>
            </div>

            <div class="mail-progress-item">
                <div class="mail-progress-info">
                    <span><span class="progress-dot dot-orange"></span> En cours</span>
                    <strong>42 <small>(17 %)</small></strong>
                </div>
                <div class="mail-progress-track">
                    <div class="mail-progress-bar bar-orange" style="width: 17%"></div>
                </div>
            </div>

            <div class="mail-progress-item">
                <div class="mail-progress-info">
                    <span><span class="progress-dot dot-red"></span> En attente</span>
                    <strong>20 <small>(8 %)</small></strong>
                </div>
                <div class="mail-progress-track">
                    <div class="mail-progress-bar bar-red" style="width: 8%"></div>
                </div>
            </div>
        </div>
    </div>

    {# Liste des courriers #}
    <div class="mail-table-card">
        <div class="mail-table-heading">
            <div>
                <h3>Registre des courriers</h3>
                <p>Consultez les courriers et leur état de traitement.</p>
            </div>
            <span class="mail-record-count"><span id="visibleCount">8</span> courriers affichés</span>
        </div>

        {# Filtres #}
        <div class="mail-filters">
            <div class="mail-search">
                <i class="bi bi-search"></i>
                <input type="search" id="searchCourier"
                       placeholder="Rechercher une référence, un objet, un expéditeur...">
            </div>

            <select id="filterType" aria-label="Filtrer par type">
                <option value="">Tous les types</option>
                <option value="Entrant">Entrant</option>
                <option value="Sortant">Sortant</option>
            </select>

            <select id="filterStatus" aria-label="Filtrer par statut">
                <option value="">Tous les statuts</option>
                <option value="Traité">Traité</option>
                <option value="En cours">En cours</option>
                <option value="En attente">En attente</option>
            </select>

            <select id="filterService" aria-label="Filtrer par service">
                <option value="">Tous les services</option>
                <option value="Direction générale">Direction générale</option>
                <option value="Ressources humaines">Ressources humaines</option>
                <option value="Finances">Finances</option>
                <option value="Informatique">Informatique</option>
                <option value="Secrétariat">Secrétariat</option>
            </select>

            <button type="button" class="mail-btn mail-btn-light mail-reset" onclick="resetCourierFilters()">
                <i class="bi bi-arrow-counterclockwise"></i>
                Réinitialiser
            </button>
        </div>

        {# Tableau #}
        <div class="mail-table-wrapper">
            <table class="mail-table" id="courrierTable">
                <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Objet du courrier</th>
                        <th>Type</th>
                        <th>Expéditeur / Destinataire</th>
                        <th>Service responsable</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-type="Entrant" data-status="En attente" data-service="Direction générale">
                        <td><span class="mail-reference">CR-2026-001</span></td>
                        <td>
                            <div class="mail-subject">Demande de partenariat</div>
                            <div class="mail-subject-note">Document administratif</div>
                        </td>
                        <td><span class="mail-type type-in"><i class="bi bi-arrow-down-left"></i> Entrant</span></td>
                        <td>
                            <div class="mail-person">Ministère partenaire</div>
                            <div class="mail-subject-note">Externe</div>
                        </td>
                        <td>Direction générale</td>
                        <td>28/10/2026</td>
                        <td><span class="mail-status status-pending"><span></span> En attente</span></td>
                        <td>
                            <div class="mail-row-actions">
                                <button type="button" title="Consulter" aria-label="Consulter CR-2026-001" onclick="viewCourier(this)"><i class="bi bi-eye"></i></button>
                                <button type="button" title="Modifier" aria-label="Modifier CR-2026-001" onclick="editCourier(this)"><i class="bi bi-pencil"></i></button>
                                <button type="button" title="Supprimer" aria-label="Supprimer CR-2026-001" onclick="deleteCourier(this)"><i class="bi bi-trash3"></i></button>
                            </div>
