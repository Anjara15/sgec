                        </td>
                        <td>Ressources humaines</td>
                        <td>27/10/2026</td>
                        <td><span class="mail-status status-done"><span></span> Traité</span></td>
                        <td>
                            <div class="mail-row-actions">
                                <button type="button" title="Consulter" aria-label="Consulter CR-2026-002" onclick="viewCourier(this)"><i class="bi bi-eye"></i></button>
