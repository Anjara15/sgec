                    <tr data-type="Entrant" data-status="En attente" data-service="Secrétariat">
                        <td><span class="mail-reference">CR-2026-006</span></td>
                        <td>
                            <div class="mail-subject">Demande de documentation</div>
                            <div class="mail-subject-note">Demande d'information</div>
                        </td>
                        <td><span class="mail-type type-in"><i class="bi bi-arrow-down-left"></i> Entrant</span></td>
