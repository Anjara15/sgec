{# templates/admin/parametres.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Paramètres - SGEC' %}
{% set pageHeading = 'Paramètres du système' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques'},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historiques'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres', active: true}
] %}

{% block title %}Paramètres | SGEC{% endblock %}

{% block dashboard_content %}
<div class="settings-page">

    <div class="settings-header">
        <div>
            <div class="settings-eyebrow">
                <i class="bi bi-sliders"></i>
                CONFIGURATION DU SYSTÈME
            </div>
            <h1>Paramètres</h1>
            <p>Configurez les informations générales, les préférences et la sécurité de SGEC.</p>
        </div>
        <div class="settings-header-icon">
            <i class="bi bi-gear-wide-connected"></i>
        </div>
    </div>

    <div class="settings-layout">

        {# Navigation des paramètres #}
        <aside class="settings-nav">
            <div class="settings-nav-heading">CONFIGURATION</div>

            <button type="button" class="settings-nav-item active" data-section="general">
                <i class="bi bi-building"></i>
                <span>Informations générales</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button type="button" class="settings-nav-item" data-section="preferences">
                <i class="bi bi-palette"></i>
                <span>Préférences</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button type="button" class="settings-nav-item" data-section="notifications">
                <i class="bi bi-bell"></i>
                <span>Notifications</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button type="button" class="settings-nav-item" data-section="security">
                <i class="bi bi-shield-lock"></i>
                <span>Sécurité</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <button type="button" class="settings-nav-item" data-section="documents">
                <i class="bi bi-file-earmark-text"></i>
                <span>Gestion documentaire</span>
                <i class="bi bi-chevron-right nav-chevron"></i>
            </button>

            <div class="settings-nav-footer">
                <div class="settings-status-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <strong>Système opérationnel</strong>
                    <span>Configuration locale</span>
                </div>
            </div>
        </aside>

        <div class="settings-content">

            {# INFORMATIONS GÉNÉRALES #}
            <section class="settings-section active" id="section-general">
                <div class="settings-section-heading">
                    <div class="settings-section-icon blue-icon"><i class="bi bi-building"></i></div>
                    <div>
                        <h2>Informations générales</h2>
                        <p>Les informations principales de votre plateforme SGEC.</p>
                    </div>
                </div>

                <form id="generalForm">
                    <div class="settings-form-grid">
                        <div class="settings-field settings-field-full">
                            <label for="systemName">Nom de l'application</label>
                            <input id="systemName" name="systemName" type="text"
                                   value="SGEC" required>
                            <small>Nom affiché dans l'interface de l'application.</small>
                        </div>

                        <div class="settings-field settings-field-full">
                            <label for="organization">Nom de l'organisation</label>
                            <input id="organization" name="organization" type="text"
                                   value="Service de Gestion Électronique des Courriers" required>
                        </div>

                        <div class="settings-field">
                            <label for="adminEmail">E-mail de contact</label>
                            <input id="adminEmail" name="adminEmail" type="email"
                                   value="admin@sgec.local" required>
                        </div>

                        <div class="settings-field">
                            <label for="systemLanguage">Langue de l'interface</label>
                            <select id="systemLanguage" name="systemLanguage">
                                <option value="fr" selected>Français</option>
                                <option value="en">English</option>
                                <option value="mg">Malagasy</option>
                            </select>
                        </div>

                        <div class="settings-field">
                            <label for="systemTimezone">Fuseau horaire</label>
                            <select id="systemTimezone" name="systemTimezone">
                                <option value="Indian/Antananarivo" selected>Antananarivo (UTC+3)</option>
                                <option value="Europe/Paris">Paris</option>
                                <option value="UTC">UTC</option>
                            </select>
                        </div>

                        <div class="settings-field">
                            <label for="dateFormat">Format de date</label>
                            <select id="dateFormat" name="dateFormat">
                                <option value="d/m/Y" selected>JJ/MM/AAAA</option>
                                <option value="Y-m-d">AAAA-MM-JJ</option>
                                <option value="m/d/Y">MM/JJ/AAAA</option>
                            </select>
                        </div>
                    </div>

                    <div class="settings-form-footer">
                        <span><i class="bi bi-info-circle"></i> Les modifications de cette démo sont locales à la page.</span>
                        <button class="settings-btn settings-btn-primary" type="submit">
                            <i class="bi bi-check2"></i> Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </section>

            {# PRÉFÉRENCES #}
            <section class="settings-section" id="section-preferences" hidden>
                <div class="settings-section-heading">
                    <div class="settings-section-icon purple-icon"><i class="bi bi-palette"></i></div>
                    <div>
                        <h2>Préférences de l'interface</h2>
                        <p>Personnalisez votre expérience d'utilisation.</p>
                    </div>
                </div>

                <form id="preferencesForm">
                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Mode sombre</strong>
                            <span>Utiliser une interface sombre lorsqu'elle est prise en charge.</span>
                        </div>
                        <label class="settings-switch">
                            <input type="checkbox" name="darkMode" id="darkMode">
                            <span class="settings-switch-slider"></span>
                        </label>
                    </div>

                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Menu latéral compact</strong>
                            <span>Réduire l'espace occupé par la navigation lorsque le layout le permet.</span>
                        </div>
                        <label class="settings-switch">
                            <input type="checkbox" name="compactMenu" id="compactMenu">
                            <span class="settings-switch-slider"></span>
                        </label>
                    </div>

                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Animations de l'interface</strong>
                            <span>Activer les transitions visuelles dans les menus et les panneaux.</span>
                        </div>
                        <label class="settings-switch">
                            <input type="checkbox" name="animations" id="animations" checked>
                            <span class="settings-switch-slider"></span>
                        </label>
                    </div>

                    <div class="settings-field settings-field-full settings-select-theme">
                        <label for="accentColor">Couleur principale</label>
                        <select id="accentColor" name="accentColor">
                            <option value="blue" selected>Bleu professionnel</option>
                            <option value="green">Vert</option>
                            <option value="purple">Violet</option>
                            <option value="teal">Turquoise</option>
                        </select>
                    </div>

                    <div class="settings-form-footer">
                        <span>Préférences d'affichage</span>
                        <button class="settings-btn settings-btn-primary" type="submit">
                            <i class="bi bi-check2"></i> Enregistrer les préférences
                        </button>
                    </div>
                </form>
            </section>

            {# NOTIFICATIONS #}
            <section class="settings-section" id="section-notifications" hidden>
                <div class="settings-section-heading">
                    <div class="settings-section-icon orange-icon"><i class="bi bi-bell"></i></div>
                    <div>
                        <h2>Notifications</h2>
                        <p>Choisissez les événements pour lesquels vous souhaitez recevoir une notification.</p>
                    </div>
                </div>

                <form id="notificationsForm">
                    <div class="settings-notification-group">
                        <h3>Courriers</h3>

                        <div class="settings-option">
                            <div class="settings-option-text">
                                <strong>Nouveau courrier entrant</strong>
                                <span>Être informé lorsqu'un nouveau courrier est enregistré.</span>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox" name="newIncoming" checked>
                                <span class="settings-switch-slider"></span>
                            </label>
                        </div>

                        <div class="settings-option">
                            <div class="settings-option-text">
                                <strong>Courrier en attente</strong>
                                <span>Signaler les courriers nécessitant une action.</span>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox" name="pendingCourier" checked>
                                <span class="settings-switch-slider"></span>
                            </label>
                        </div>

                        <div class="settings-option">
                            <div class="settings-option-text">
                                <strong>Changement de statut</strong>
                                <span>Recevoir une notification lorsqu'un courrier est traité.</span>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox" name="statusChange" checked>
                                <span class="settings-switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-notification-group">
                        <h3>Administration</h3>

                        <div class="settings-option">
                            <div class="settings-option-text">
                                <strong>Création d'un utilisateur</strong>
                                <span>Signaler l'ajout d'un nouvel utilisateur à la plateforme.</span>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox" name="newUser">
                                <span class="settings-switch-slider"></span>
                            </label>
                        </div>

                        <div class="settings-option">
                            <div class="settings-option-text">
                                <strong>Alertes de sécurité</strong>
                                <span>Être averti des événements de sécurité importants.</span>
                            </div>
                            <label class="settings-switch">
                                <input type="checkbox" name="securityAlerts" checked>
                                <span class="settings-switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-form-footer">
                        <span>Canal de notification : interface web (démo)</span>
                        <button class="settings-btn settings-btn-primary" type="submit">
                            <i class="bi bi-check2"></i> Enregistrer les notifications
                        </button>
                    </div>
                </form>
            </section>

            {# SÉCURITÉ #}
            <section class="settings-section" id="section-security" hidden>
                <div class="settings-section-heading">
                    <div class="settings-section-icon green-icon"><i class="bi bi-shield-lock"></i></div>
                    <div>
                        <h2>Sécurité et accès</h2>
                        <p>Consultez les options de sécurité de la plateforme.</p>
                    </div>
                </div>

                <div class="settings-security-banner">
                    <div class="security-banner-icon"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <strong>Protégez votre espace d'administration</strong>
                        <p>Utilisez des mots de passe robustes et limitez les accès aux utilisateurs autorisés.</p>
                    </div>
                </div>

                <form id="securityForm">
                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Déconnexion automatique</strong>
                            <span>Activer la déconnexion après une période d'inactivité.</span>
                        </div>
                        <label class="settings-switch">
                            <input type="checkbox" id="autoLogout" name="autoLogout" checked>
                            <span class="settings-switch-slider"></span>
                        </label>
                    </div>

                    <div class="settings-field settings-field-full security-timeout">
                        <label for="sessionTimeout">Durée d'inactivité avant déconnexion</label>
                        <select id="sessionTimeout" name="sessionTimeout">
                            <option value="15">15 minutes</option>
                            <option value="30" selected>30 minutes</option>
                            <option value="60">60 minutes</option>
                            <option value="120">120 minutes</option>
                        </select>
                    </div>

                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Journalisation des connexions</strong>
                            <span>Conserver une trace des connexions et des tentatives de connexion.</span>
                        </div>
                        <label class="settings-switch">
                            <input type="checkbox" name="loginLogging" checked>
                            <span class="settings-switch-slider"></span>
                        </label>
                    </div>

                    <div class="settings-option">
                        <div class="settings-option-text">
                            <strong>Authentification à deux facteurs</strong>
                            <span>Option à mettre en place côté serveur avant de pouvoir l'utiliser.</span>
                        </div>
                        <span class="settings-badge settings-badge-neutral">À configurer</span>
                    </div>

                    <div class="settings-form-footer">
                        <span><i class="bi bi-lock"></i> Les paramètres de sécurité réels doivent être appliqués côté serveur.</span>
                        <button class="settings-btn settings-btn-primary" type="submit">
                            <i class="bi bi-check2"></i> Enregistrer
                        </button>
                    </div>
                </form>
            </section>

            {# GESTION DOCUMENTAIRE #}
            <section class="settings-section" id="section-documents" hidden>
                <div class="settings-section-heading">
                    <div class="settings-section-icon blue-icon"><i class="bi bi-file-earmark-text"></i></div>
                    <div>
                        <h2>Gestion documentaire</h2>
                        <p>Définissez les règles générales d'enregistrement des courriers.</p>
                    </div>
                </div>

                <form id="documentsForm">
                    <div class="settings-form-grid">
                        <div class="settings-field">
                            <label for="referencePrefix">Préfixe de référence</label>
                            <input id="referencePrefix" name="referencePrefix" value="CR" maxlength="10" required>
                            <small>Exemple : CR-2026-001.</small>
                        </div>

                        <div class="settings-field">
                            <label for="referenceDigits">Nombre de chiffres du numéro</label>
                            <select id="referenceDigits" name="referenceDigits">
                                <option value="3" selected>3 chiffres (001)</option>
                                <option value="4">4 chiffres (0001)</option>
                                <option value="5">5 chiffres (00001)</option>
                            </select>
                        </div>

                        <div class="settings-field">
                            <label for="defaultCourierStatus">Statut initial d'un courrier</label>
                            <select id="defaultCourierStatus" name="defaultCourierStatus">
                                <option value="En attente" selected>En attente</option>
                                <option value="En cours">En cours</option>
                            </select>
                        </div>

                        <div class="settings-field">
                            <label for="allowedFileSize">Taille maximale des pièces jointes</label>
                            <select id="allowedFileSize" name="allowedFileSize">
                                <option value="5">5 Mo</option>
                                <option value="10" selected>10 Mo</option>
                                <option value="20">20 Mo</option>
                                <option value="50">50 Mo</option>
                            </select>
                        </div>

                        <div class="settings-field settings-field-full">
                            <label for="documentRetention">Durée de conservation indicative</label>
                            <select id="documentRetention" name="documentRetention">
                                <option value="1">1 an</option>
                                <option value="5">5 ans</option>
                                <option value="10" selected>10 ans</option>
                                <option value="permanent">Conservation permanente</option>
                            </select>
                            <small>Cette préférence ne remplace pas les règles légales ou institutionnelles d'archivage.</small>
                        </div>
                    </div>

                    <div class="settings-form-footer">
                        <span><i class="bi bi-info-circle"></i> Les valeurs seront à relier à la configuration serveur.</span>
                        <button class="settings-btn settings-btn-primary" type="submit">
                            <i class="bi bi-check2"></i> Enregistrer la configuration
                        </button>
                    </div>
                </form>
            </section>

        </div>
    </div>

    <div class="settings-toast" id="settingsToast" role="status" aria-live="polite"></div>
</div>

<style>
.settings-page {
    --settings-primary: #2457d6;
    --settings-text: #17233d;
    --settings-muted: #7b879b;
    --settings-border: #e8edf5;
    color: var(--settings-text);
    padding-bottom: 32px;
}
.settings-page * { box-sizing: border-box; }
.settings-header {
    display: flex; justify-content: space-between; align-items: center;
    gap: 20px; margin-bottom: 26px;
}
.settings-eyebrow {
    display: flex; align-items: center; gap: 7px;
    color: var(--settings-primary); font-size: 10px;
    font-weight: 800; letter-spacing: 1.3px;
}
.settings-header h1 {
    margin: 8px 0 5px; font-size: clamp(24px, 3vw, 30px);
    font-weight: 800; letter-spacing: -.7px;
}
.settings-header p { margin: 0; font-size: 13px; color: var(--settings-muted); }
.settings-header-icon {
    width: 58px; height: 58px; border-radius: 16px;
    display: grid; place-items: center; flex-shrink: 0;
    color: var(--settings-primary); background: #eaf0ff; font-size: 25px;
}
.settings-layout {
    display: grid; grid-template-columns: 245px minmax(0, 1fr);
    align-items: start; gap: 20px;
}
.settings-nav, .settings-content {
    background: #fff; border: 1px solid var(--settings-border);
    border-radius: 14px; overflow: hidden;
}
.settings-nav { padding: 15px 10px; }
.settings-nav-heading {
    color: #9aa4b5; font-size: 10px; font-weight: 800;
    letter-spacing: 1px; padding: 8px 12px 13px;
}
.settings-nav-item {
    width: 100%; display: flex; align-items: center; gap: 11px;
    padding: 12px; margin-bottom: 4px; border: 0; border-radius: 9px;
    background: transparent; color: #647189; font-size: 12px;
    font-weight: 600; text-align: left; cursor: pointer; transition: .2s;
}
.settings-nav-item > i:first-child { font-size: 16px; }
.settings-nav-item span { flex: 1; }
.settings-nav-item:hover { background: #f6f8fd; color: var(--settings-primary); }
.settings-nav-item.active { background: #edf2ff; color: var(--settings-primary); font-weight: 800; }
.settings-nav-item.active .nav-chevron { opacity: 1; }
.nav-chevron { margin-left: auto; font-size: 11px; opacity: 0; }
.settings-nav-footer {
    display: flex; align-items: center; gap: 10px;
    border-top: 1px solid #edf0f6; margin-top: 15px; padding: 17px 8px 5px;
}
.settings-status-icon { color: #25a267; font-size: 17px; }
.settings-nav-footer strong, .settings-nav-footer span { display: block; }
.settings-nav-footer strong { font-size: 10px; }
.settings-nav-footer span { margin-top: 4px; font-size: 10px; color: #9aa4b5; }
.settings-section { padding: 25px; }
.settings-section[hidden] { display: none !important; }
.settings-section-heading {
    display: flex; align-items: center; gap: 13px;
    padding-bottom: 22px; margin-bottom: 22px;
    border-bottom: 1px solid #edf0f6;
}
.settings-section-heading h2 { margin: 0 0 5px; font-size: 17px; font-weight: 800; }
.settings-section-heading p { margin: 0; color: var(--settings-muted); font-size: 11px; line-height: 1.6; }
.settings-section-icon {
    width: 43px; height: 43px; flex-shrink: 0;
    display: grid; place-items: center; border-radius: 12px; font-size: 19px;
}
.blue-icon { background: #eaf0ff; color: #315fdb; }
.purple-icon { background: #f1eaff; color: #8452cc; }
.orange-icon { background: #fff2e3; color: #d9821b; }
.green-icon { background: #e4f8ed; color: #23985a; }
.settings-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 19px; }
.settings-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.settings-field-full { grid-column: 1 / -1; }
.settings-field label { font-size: 11px; font-weight: 700; color: #536078; }
.settings-field input, .settings-field select {
    width: 100%; min-height: 42px; padding: 10px 12px;
    border: 1px solid #e1e7f0; border-radius: 8px;
    background: #fff; color: #34415a; font-size: 12px; outline: none;
}
.settings-field input:focus, .settings-field select:focus {
    border-color: #7da0fa; box-shadow: 0 0 0 3px rgba(36,87,214,.08);
}
.settings-field small { color: #9aa4b5; font-size: 10px; line-height: 1.5; }
.settings-form-footer {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 15px; border-top: 1px solid #edf0f6;
    padding-top: 20px; margin-top: 25px;
}
.settings-form-footer > span { font-size: 10px; color: #929db0; }
.settings-form-footer > span i { margin-right: 5px; }
.settings-btn {
    display: inline-flex; justify-content: center; align-items: center; gap: 8px;
    border-radius: 8px; padding: 11px 14px; font-size: 11px;
    font-weight: 700; cursor: pointer; border: 1px solid transparent;
    transition: .2s;
}
.settings-btn-primary { background: var(--settings-primary); color: #fff; }
.settings-btn-primary:hover { background: #1744b4; color: #fff; }
.settings-option {
    display: flex; justify-content: space-between; align-items: center;
    gap: 18px; padding: 18px 0; border-bottom: 1px solid #f0f2f7;
}
.settings-option-text { display: flex; flex-direction: column; gap: 6px; }
.settings-option-text strong { font-size: 12px; font-weight: 700; color: #34415a; }
.settings-option-text span { font-size: 10px; line-height: 1.6; color: #929db0; }
.settings-switch { position: relative; width: 39px; height: 22px; flex-shrink: 0; }
.settings-switch input { width: 0; height: 0; opacity: 0; }
.settings-switch-slider {
    position: absolute; inset: 0; cursor: pointer;
    background: #dce2ec; border-radius: 30px; transition: .2s;
}
.settings-switch-slider::before {
    content: ""; position: absolute; width: 16px; height: 16px;
    left: 3px; top: 3px; border-radius: 50%; background: #fff;
    box-shadow: 0 1px 3px rgba(0,0,0,.15); transition: .2s;
}
.settings-switch input:checked + .settings-switch-slider { background: var(--settings-primary); }
.settings-switch input:checked + .settings-switch-slider::before { transform: translateX(17px); }
.settings-switch input:focus-visible + .settings-switch-slider { outline: 3px solid #a8c0ff; outline-offset: 2px; }
.settings-select-theme { margin-top: 22px; }
.settings-notification-group { margin-bottom: 25px; }
.settings-notification-group h3 {
    font-size: 12px; font-weight: 800; color: #52617a;
    padding-bottom: 10px; border-bottom: 1px solid #edf0f6; margin: 0;
}
.settings-security-banner {
    display: flex; align-items: flex-start; gap: 13px; padding: 16px;
    background: #eef9f3; border: 1px solid #d8f0e2; border-radius: 10px;
    margin-bottom: 18px;
}
.security-banner-icon { color: #25965d; font-size: 23px; }
.settings-security-banner strong { font-size: 12px; color: #27784e; }
.settings-security-banner p { font-size: 10px; color: #5e8b73; margin: 6px 0 0; line-height: 1.6; }
.security-timeout { margin: 20px 0; max-width: 350px; }
.settings-badge {
    border-radius: 6px; padding: 6px 9px; font-size: 10px;
    font-weight: 700; white-space: nowrap;
}
.settings-badge-neutral { color: #7b879b; background: #f0f2f6; }
.settings-toast {
    position: fixed; right: 24px; bottom: 24px; z-index: 10000;
    max-width: calc(100vw - 40px); padding: 13px 17px; border-radius: 9px;
    background: #17233d; color: #fff; box-shadow: 0 8px 25px rgba(0,0,0,.15);
    font-size: 12px; opacity: 0; pointer-events: none; transform: translateY(8px);
    transition: .2s;
}
.settings-toast.show { opacity: 1; transform: translateY(0); }
@media (max-width: 1000px) {
    .settings-layout { grid-template-columns: 205px minmax(0, 1fr); gap: 14px; }
    .settings-section { padding: 20px; }
}
@media (max-width: 760px) {
    .settings-layout { grid-template-columns: 1fr; }
    .settings-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px; }
    .settings-nav-heading, .settings-nav-footer { grid-column: 1 / -1; }
    .settings-nav-item { margin: 0; padding: 11px 9px; font-size: 11px; }
    .settings-nav-item .nav-chevron { display: none; }
    .settings-header-icon { width: 46px; height: 46px; font-size: 21px; }
}
@media (max-width: 520px) {
    .settings-header { align-items: flex-start; }
    .settings-header-icon { display: none; }
    .settings-section { padding: 17px 14px; }
    .settings-form-grid { grid-template-columns: 1fr; }
    .settings-field-full { grid-column: auto; }
    .settings-form-footer { align-items: stretch; flex-direction: column; }
    .settings-form-footer .settings-btn { width: 100%; }
    .settings-section-heading h2 { font-size: 15px; }
    .settings-nav-item { gap: 7px; }
}
</style>

<script>
(function () {
    const page = document.querySelector('.settings-page');
    if (!page || page.dataset.initialized === 'true') return;
    page.dataset.initialized = 'true';

    const navItems = page.querySelectorAll('.settings-nav-item');
    const sections = page.querySelectorAll('.settings-section');
    const toast = page.querySelector('#settingsToast');
    let toastTimer;

    function showToast(message) {
        toast.textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3200);
    }

    function activateSection(name) {
        navItems.forEach(item => {
            const active = item.dataset.section === name;
            item.classList.toggle('active', active);
            item.setAttribute('aria-current', active ? 'page' : 'false');
        });

        sections.forEach(section => {
            const active = section.id === 'section-' + name;
            section.hidden = !active;
            section.classList.toggle('active', active);
        });
    }

    navItems.forEach(item => {
        item.addEventListener('click', () => activateSection(item.dataset.section));
    });

    page.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', event => {
            event.preventDefault();
            if (!form.reportValidity()) return;

            showToast('Paramètres validés dans la démonstration. Ils ne sont pas encore enregistrés en base de données.');
        });
    });

    const autoLogout = page.querySelector('#autoLogout');
    const timeout = page.querySelector('#sessionTimeout');

    function updateTimeoutAvailability() {
        timeout.disabled = !autoLogout.checked;
        timeout.style.opacity = autoLogout.checked ? '1' : '.55';
    }

    autoLogout.addEventListener('change', updateTimeoutAvailability);
    updateTimeoutAvailability();

    const darkMode = page.querySelector('#darkMode');
    darkMode.addEventListener('change', () => {
        showToast(darkMode.checked
            ? 'Option mode sombre sélectionnée. Le thème global reste à intégrer.'
            : 'Mode clair sélectionné.');
    });
})();
</script>
{% endblock %}
