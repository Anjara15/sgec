
{% extends 'layouts/dashboard.html.twig' %}

{% set title = 'Administration - SGEC' %}
{% set pageHeading = 'Statistiques' %}
{% set roleLabel = 'Administrateur' %}
{% set demoUser = 'Admin SGEC' %}

{% set menu = [
    {label: 'Tableau de bord', icon: 'bi-grid-1x2', url: '/admin/dashboard'},
    {label: 'Utilisateurs', icon: 'bi-people', url: '/admin/utilisateurs'},
    {label: 'Rôles et permissions', icon: 'bi-shield-lock', url: '/admin/roles'},
    {label: 'Services', icon: 'bi-building', url: '/admin/services'},
    {label: 'Tous les courriers', icon: 'bi-envelope-paper', url: '/admin/courriers'},
    {label: 'Statistiques', icon: 'bi-bar-chart', url: '/admin/statistiques', active: true},
    {label: 'Journal d’activité', icon: 'bi-clock-history', url: '/admin/historique'},
    {label: 'Paramètres', icon: 'bi-gear', url: '/admin/parametres'}
] %}

{% block title %}Statistiques | SGEC{% endblock %}

{% block dashboard_content %}

<div class="stats-page">

    {# En-tête #}
    <div class="stats-header">
        <div>
            <span class="stats-eyebrow">
                <i class="bi bi-graph-up-arrow"></i> ANALYSE ET RAPPORTS
            </span>
            <h2>Statistiques générales</h2>
            <p>Suivez l’activité et les performances de gestion des courriers.</p>
        </div>

        <button class="btn-export" type="button" onclick="exportStats()">
            <i class="bi bi-download"></i>
            Exporter les données
        </button>
    </div>

    {# Filtres #}
    <div class="stats-filter">
        <div class="filter-title">
            <i class="bi bi-funnel"></i>
            Filtrer les statistiques
        </div>

        <div class="filter-controls">
            <div class="filter-field">
                <label for="periodFilter">Période</label>
                <select id="periodFilter">
                    <option value="month">Ce mois</option>
                    <option value="week">Cette semaine</option>
                    <option value="year">Cette année</option>
                    <option value="all">Toute la période</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="serviceFilter">Service</label>
                <select id="serviceFilter">
                    <option value="all">Tous les services</option>
                    <option value="secretariat">Secrétariat général</option>
                    <option value="rh">Ressources humaines</option>
                    <option value="finance">Service financier</option>
                    <option value="archives">Archives</option>
                </select>
            </div>

            <button class="btn-filter" type="button" onclick="applyFilters()">
                <i class="bi bi-arrow-repeat"></i> Appliquer
            </button>
        </div>
    </div>

    {# Cartes principales #}
    <div class="stats-cards">

        <div class="stat-card stat-blue">
            <div class="stat-card-top">
                <div class="stat-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <span class="stat-tag">Courriers</span>
            </div>
            <div class="stat-value" id="totalCourriers">1 284</div>
            <div class="stat-label">Total des courriers</div>
            <div class="stat-bottom">
                <i class="bi bi-info-circle"></i>
                <span>Courriers enregistrés</span>
            </div>
        </div>

        <div class="stat-card stat-orange">
            <div class="stat-card-top">
                <div class="stat-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <span class="stat-tag">En attente</span>
            </div>
            <div class="stat-value" id="pendingCourriers">96</div>
            <div class="stat-label">Courriers en attente</div>
            <div class="stat-bottom">
                <i class="bi bi-clock"></i>
                <span>À traiter ou à transmettre</span>
            </div>
        </div>

        <div class="stat-card stat-green">
            <div class="stat-card-top">
                <div class="stat-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <span class="stat-tag">Traités</span>
            </div>
            <div class="stat-value" id="processedCourriers">1 056</div>
            <div class="stat-label">Courriers traités</div>
            <div class="stat-bottom">
                <i class="bi bi-check-circle"></i>
                <span>Traitement effectué</span>
            </div>
        </div>

        <div class="stat-card stat-purple">
            <div class="stat-card-top">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <span class="stat-tag">Utilisateurs</span>
            </div>
            <div class="stat-value" id="totalUsers">42</div>
            <div class="stat-label">Utilisateurs actifs</div>
            <div class="stat-bottom">
                <i class="bi bi-person-check"></i>
                <span>Comptes actifs</span>
            </div>
        </div>

    </div>

    {# Graphiques #}
    <div class="charts-grid">

        <section class="stats-panel chart-panel">
            <div class="panel-header">
                <div>
                    <h3>Évolution des courriers</h3>
                    <p>Volume des courriers entrants et sortants</p>
                </div>
                <span class="panel-icon">
                    <i class="bi bi-activity"></i>
                </span>
            </div>

            <div class="chart-container">
                <canvas id="evolutionChart"></canvas>
            </div>
        </section>

        <section class="stats-panel chart-panel">
            <div class="panel-header">
                <div>
                    <h3>Répartition par statut</h3>
                    <p>État actuel des courriers enregistrés</p>
                </div>
                <span class="panel-icon">
                    <i class="bi bi-pie-chart"></i>
                </span>
            </div>

            <div class="chart-container chart-doughnut">
                <canvas id="statusChart"></canvas>
            </div>

            <div class="chart-legend">
                <span><i class="legend-dot dot-green"></i> Traités</span>
                <span><i class="legend-dot dot-orange"></i> En attente</span>
                <span><i class="legend-dot dot-red"></i> En retard</span>
            </div>
        </section>

    </div>

    {# Statistiques des services #}
    <section class="stats-panel services-panel">
        <div class="panel-header">
            <div>
                <h3>Performance par service</h3>
                <p>Comparaison du volume et du traitement des courriers</p>
            </div>
            <span class="panel-icon">
                <i class="bi bi-building"></i>
            </span>
        </div>

        <div class="table-responsive">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Total reçu</th>
                        <th>Traités</th>
                        <th>En attente</th>
                        <th>Taux de traitement</th>
                    </tr>
                </thead>
                <tbody id="serviceTableBody">
                    <tr data-service="secretariat">
                        <td>
                            <div class="service-name">
                                <span class="service-avatar avatar-blue">SG</span>
                                <div>
                                    <strong>Secrétariat général</strong>
                                    <small>Administration générale</small>
                                </div>
                            </div>
                        </td>
                        <td>420</td>
                        <td>365</td>
                        <td><span class="pending-badge">55</span></td>
                        <td>
                            <div class="progress-cell">
                                <div class="progress-track">
                                    <div class="progress-fill fill-blue" style="width: 87%"></div>
                                </div>
                                <strong>87 %</strong>
                            </div>
                        </td>
                    </tr>

                    <tr data-service="rh">
                        <td>
                            <div class="service-name">
                                <span class="service-avatar avatar-purple">RH</span>
                                <div>
                                    <strong>Ressources humaines</strong>
                                    <small>Gestion du personnel</small>
                                </div>
                            </div>
                        </td>
                        <td>315</td>
                        <td>276</td>
                        <td><span class="pending-badge">39</span></td>
                        <td>
                            <div class="progress-cell">
                                <div class="progress-track">
                                    <div class="progress-fill fill-purple" style="width: 88%"></div>
                                </div>
                                <strong>88 %</strong>
                            </div>
                        </td>
                    </tr>

                    <tr data-service="finance">
                        <td>
                            <div class="service-name">
                                <span class="service-avatar avatar-green">SF</span>
                                <div>
                                    <strong>Service financier</strong>
                                    <small>Budget et comptabilité</small>
                                </div>
                            </div>
                        </td>
                        <td>287</td>
                        <td>251</td>
                        <td><span class="pending-badge">36</span></td>
                        <td>
                            <div class="progress-cell">
                                <div class="progress-track">
                                    <div class="progress-fill fill-green" style="width: 87%"></div>
                                </div>
                                <strong>87 %</strong>
                            </div>
                        </td>
                    </tr>

                    <tr data-service="archives">
                        <td>
                            <div class="service-name">
                                <span class="service-avatar avatar-orange">AR</span>
                                <div>
                                    <strong>Archives</strong>
                                    <small>Classement et conservation</small>
                                </div>
                            </div>
                        </td>
                        <td>262</td>
                        <td>164</td>
                        <td><span class="pending-badge">98</span></td>
                        <td>
                            <div class="progress-cell">
                                <div class="progress-track">
                                    <div class="progress-fill fill-orange" style="width: 63%"></div>
                                </div>
                                <strong>63 %</strong>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    {# Indicateurs complémentaires #}
    <div class="bottom-grid">

        <section class="stats-panel summary-panel">
            <div class="panel-header">
                <div>
                    <h3>Indicateurs clés</h3>
                    <p>Résumé de l'activité</p>
                </div>
                <span class="panel-icon">
                    <i class="bi bi-speedometer2"></i>
                </span>
            </div>

            <div class="summary-item">
                <div class="summary-item-icon summary-green">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="summary-item-content">
                    <span>Taux global de traitement</span>
                    <strong>82,2 %</strong>
                </div>
                <span class="summary-status">Bon</span>
            </div>

            <div class="summary-item">
                <div class="summary-item-icon summary-orange">
                    <i class="bi bi-alarm"></i>
                </div>
                <div class="summary-item-content">
                    <span>Courriers en retard</span>
                    <strong>32</strong>
                </div>
                <span class="summary-status status-warning">À surveiller</span>
            </div>

            <div class="summary-item">
                <div class="summary-item-icon summary-blue">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="summary-item-content">
                    <span>Délai moyen de traitement</span>
                    <strong>2,4 jours</strong>
                </div>
                <span class="summary-status">Moyenne</span>
            </div>
        </section>

        <section class="stats-panel activity-panel">
            <div class="panel-header">
                <div>
                    <h3>Dernières activités</h3>
                    <p>Événements récents du système</p>
                </div>
                <span class="panel-icon">
                    <i class="bi bi-clock-history"></i>
                </span>
            </div>

            <div class="activity-list">
                <div class="activity-item">
                    <span class="activity-icon activity-blue">
                        <i class="bi bi-envelope-plus"></i>
                    </span>
                    <div class="activity-content">
                        <strong>Nouveau courrier enregistré</strong>
                        <span>Secrétariat général</span>
                    </div>
                    <time>09:45</time>
                </div>

                <div class="activity-item">
                    <span class="activity-icon activity-green">
                        <i class="bi bi-check2-circle"></i>
                    </span>
                    <div class="activity-content">
                        <strong>Courrier traité</strong>
                        <span>Service financier</span>
                    </div>
                    <time>09:20</time>
                </div>

                <div class="activity-item">
                    <span class="activity-icon activity-purple">
                        <i class="bi bi-person-plus"></i>
                    </span>
                    <div class="activity-content">
                        <strong>Nouvel utilisateur ajouté</strong>
                        <span>Administration</span>
                    </div>
                    <time>Hier</time>
                </div>

                <div class="activity-item">
                    <span class="activity-icon activity-orange">
                        <i class="bi bi-arrow-left-right"></i>
                    </span>
                    <div class="activity-content">
                        <strong>Courrier transmis</strong>
                        <span>Ressources humaines</span>
                    </div>
                    <time>Hier</time>
                </div>
            </div>
        </section>

    </div>
</div>

<style>
    .stats-page {
        --stats-primary: #315bea;
        --stats-text: #17233d;
        --stats-muted: #7b879b;
        --stats-border: #e8edf5;
        color: var(--stats-text);
        padding-bottom: 28px;
    }

    .stats-page * {
        box-sizing: border-box;
    }

    .stats-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
    }

    .stats-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        color: var(--stats-primary);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .stats-header h2 {
        margin: 0 0 8px;
        color: var(--stats-text);
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -.7px;
    }

    .stats-header p,
    .panel-header p {
        margin: 0;
        color: var(--stats-muted);
        font-size: 13px;
    }

    .btn-export,
    .btn-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: 0;
        border-radius: 9px;
        padding: 12px 16px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

    .btn-export {
        flex-shrink: 0;
        background: #315bea;
        color: #fff;
        box-shadow: 0 5px 14px #315bea25;
    }

    .btn-export:hover,
    .btn-filter:hover {
        background: #2347c5;
        color: #fff;
        transform: translateY(-1px);
    }

    .stats-filter {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 18px 20px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid var(--stats-border);
        border-radius: 13px;
    }

    .filter-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 13px;
        font-weight: 750;
    }

    .filter-title i {
        color: var(--stats-primary);
        font-size: 17px;
    }

    .filter-controls {
        display: flex;
        align-items: end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-field label {
        color: #7b879b;
        font-size: 10px;
        font-weight: 700;
    }

    .filter-field select {
        min-width: 155px;
        padding: 10px 12px;
        color: #35415b;
        background: #fbfcff;
        border: 1px solid #e2e8f2;
        border-radius: 8px;
        font-size: 12px;
        outline: none;
    }

    .filter-field select:focus {
        border-color: var(--stats-primary);
    }

    .btn-filter {
        padding: 10px 14px;
        background: #315bea;
        color: white;
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 17px;
        margin-bottom: 22px;
    }

    .stat-card {
        min-width: 0;
        padding: 20px;
        background: #fff;
        border: 1px solid var(--stats-border);
        border-radius: 13px;
        box-shadow: 0 3px 12px #192f5905;
    }

    .stat-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 18px;
    }

    .stat-icon {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        border-radius: 11px;
        font-size: 20px;
    }

    .stat-tag {
        padding: 6px 9px;
        border-radius: 20px;
        background: #f4f6fb;
        color: #68758b;
        font-size: 10px;
        font-weight: 700;
    }

    .stat-blue .stat-icon { background: #edf2ff; color: #315bea; }
    .stat-orange .stat-icon { background: #fff3e7; color: #e58b26; }
    .stat-green .stat-icon { background: #e7f8ef; color: #1da56a; }
    .stat-purple .stat-icon { background: #f2edff; color: #8759dc; }

    .stat-value {
        margin-bottom: 5px;
        color: #192743;
        font-size: 29px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -.8px;
    }

    .stat-label {
        color: #59677e;
        font-size: 12px;
        font-weight: 650;
    }

    .stat-bottom {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 17px;
        padding-top: 13px;
        border-top: 1px solid #f0f2f7;
        color: #8994a7;
        font-size: 10px;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        gap: 20px;
        margin-bottom: 22px;
    }

    .stats-panel {
        min-width: 0;
        padding: 22px;
        background: #fff;
        border: 1px solid var(--stats-border);
        border-radius: 13px;
        box-shadow: 0 3px 12px #192f5905;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 22px;
    }

    .panel-header h3 {
        margin: 0 0 7px;
        color: #1c2943;
        font-size: 15px;
        font-weight: 750;
    }

    .panel-icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 37px;
        height: 37px;
        color: #315bea;
        background: #eff3ff;
        border-radius: 10px;
        font-size: 17px;
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 275px;
    }

    .chart-doughnut {
        max-width: 330px;
        height: 245px;
        margin: 0 auto;
    }

    .chart-legend {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-top: 13px;
        color: #647087;
        font-size: 11px;
    }

    .legend-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 5px;
        border-radius: 50%;
    }

    .dot-green { background: #25b77b; }
    .dot-orange { background: #f3a43b; }
    .dot-red { background: #e75a66; }

    .services-panel {
        margin-bottom: 22px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .stats-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    .stats-table thead th {
        padding: 13px 14px;
        color: #8590a4;
        background: #f8faff;
        border-top: 1px solid #eef1f7;
        border-bottom: 1px solid #eef1f7;
        text-align: left;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .stats-table tbody td {
        padding: 16px 14px;
        border-bottom: 1px solid #f0f2f7;
        color: #526078;
        font-size: 12px;
    }

    .stats-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .service-name {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .service-avatar {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 800;
    }

    .avatar-blue { background: #eaf0ff; color: #315bea; }
    .avatar-purple { background: #f0eaff; color: #8658d8; }
    .avatar-green { background: #e3f8ed; color: #169c60; }
    .avatar-orange { background: #fff0df; color: #d98625; }

    .service-name strong {
        display: block;
        margin-bottom: 4px;
        color: #26334c;
        font-size: 12px;
    }

    .service-name small {
        display: block;
        color: #8a95a7;
        font-size: 10px;
    }

    .pending-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 6px;
        background: #fff3e4;
        color: #d98725;
        font-size: 11px;
        font-weight: 750;
    }

    .progress-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 145px;
    }

    .progress-track {
        width: 90px;
        height: 6px;
        overflow: hidden;
        background: #edf0f6;
        border-radius: 20px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 20px;
    }

    .fill-blue { background: #315bea; }
    .fill-purple { background: #8759dc; }
    .fill-green { background: #20ae73; }
    .fill-orange { background: #efa03c; }

    .progress-cell strong {
        color: #36435c;
        font-size: 11px;
    }

    .bottom-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 0;
        border-bottom: 1px solid #f0f2f7;
    }

    .summary-item:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .summary-item-icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 39px;
        height: 39px;
        border-radius: 10px;
        font-size: 17px;
    }

    .summary-green { background: #e6f8ef; color: #1aa56b; }
    .summary-orange { background: #fff2e3; color: #e39431; }
    .summary-blue { background: #eaf0ff; color: #315bea; }

    .summary-item-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

    .summary-item-content span {
        color: #778399;
        font-size: 11px;
    }

    .summary-item-content strong {
        color: #25334d;
        font-size: 18px;
        font-weight: 800;
    }

    .summary-status {
        padding: 5px 8px;
        border-radius: 6px;
        background: #e8f8ef;
        color: #1c9d65;
        font-size: 9px;
