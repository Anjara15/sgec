{# Chart.js pour les graphiques #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let evolutionChart = null;
    let statusChart = null;

    const demoStats = {
        month: {
            total: 1284,
            pending: 96,
            processed: 1056,
            users: 42,
            incoming: [85, 110, 98, 125, 115, 140],
            outgoing: [65, 88, 78, 95, 102, 118]
        },
        week: {
            total: 298,
            pending: 27,
            processed: 251,
            users: 42,
            incoming: [35, 42, 38, 55, 48, 62],
            outgoing: [22, 31, 29, 41, 36, 47]
        },
        year: {
            total: 12840,
            pending: 420,
            processed: 11200,
            users: 42,
            incoming: [620, 710, 830, 790, 920, 1050],
            outgoing: [480, 560, 650, 630, 740, 880]
        },
        all: {
            total: 24560,
            pending: 730,
            processed: 21900,
            users: 42,
            incoming: [1050, 1180, 1320, 1250, 1490, 1650],
            outgoing: [820, 950, 1040, 980, 1210, 1390]
        }
    };

    function formatNumber(value) {
        return new Intl.NumberFormat('fr-FR').format(value);
    }

    function initializeCharts() {
        if (typeof Chart === 'undefined') {
            console.warn('Chart.js n’a pas pu être chargé.');
            return;
        }

        const evolutionCanvas = document.getElementById('evolutionChart');
        const statusCanvas = document.getElementById('statusChart');

        if (!evolutionCanvas || !statusCanvas) {
            return;
        }

        if (evolutionChart) evolutionChart.destroy();
        if (statusChart) statusChart.destroy();

        evolutionChart = new Chart(evolutionCanvas, {
            type: 'line',
            data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'],
                datasets: [
                    {
                        label: 'Entrants',
                        data: demoStats.month.incoming,
                        borderColor: '#315bea',
                        backgroundColor: 'rgba(49, 91, 234, 0.08)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2.5,
                        pointRadius: 3,
                        pointHoverRadius: 5
                    },
                    {
                        label: 'Sortants',
                        data: demoStats.month.outgoing,
                        borderColor: '#25b77b',
                        backgroundColor: 'rgba(37, 183, 123, 0.04)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2.5,
                        pointRadius: 3,
                        pointHoverRadius: 5
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: {
                    legend: {
                        position: 'top',
                        align: 'end',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            boxWidth: 7,
                            boxHeight: 7,
                            padding: 16,
                            color: '#6d7890',
                            font: { size: 10 }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#8a95a7', font: { size: 10 } },
                        border: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: '#edf0f6' },
                        ticks: { color: '#8a95a7', font: { size: 10 } },
                        border: { display: false }
                    }
                }
            }
        });

        statusChart = new Chart(statusCanvas, {
            type: 'doughnut',
            data: {
                labels: ['Traités', 'En attente', 'En retard'],
                datasets: [{
                    data: [1056, 96, 32],
                    backgroundColor: ['#25b77b', '#f3a43b', '#e75a66'],
                    borderWidth: 0,
                    hoverOffset: 5,
                    spacing: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

    function applyFilters() {
        const period = document.getElementById('periodFilter').value;
        const service = document.getElementById('serviceFilter').value;
        const stats = demoStats[period] || demoStats.month;

        document.getElementById('totalCourriers').textContent =
            formatNumber(stats.total);
        document.getElementById('pendingCourriers').textContent =
            formatNumber(stats.pending);
        document.getElementById('processedCourriers').textContent =
            formatNumber(stats.processed);
        document.getElementById('totalUsers').textContent =
            formatNumber(stats.users);

        if (evolutionChart) {
            evolutionChart.data.datasets[0].data = stats.incoming;
            evolutionChart.data.datasets[1].data = stats.outgoing;
            evolutionChart.update();
        }

        if (statusChart) {
            statusChart.data.datasets[0].data = [
                stats.processed,
                stats.pending,
                Math.max(1, Math.round(stats.total * 0.025))
            ];
            statusChart.update();
        }

        document.querySelectorAll('#serviceTableBody tr').forEach(row => {
            row.hidden = service !== 'all' && row.dataset.service !== service;
        });
    }

    function exportStats() {
        const headers = [
            'Service',
            'Total reçu',
            'Traités',
            'En attente',
            'Taux de traitement'
        ];

        const rows = [headers];

        document.querySelectorAll('#serviceTableBody tr').forEach(row => {
            if (row.hidden) return;

            const cells = row.querySelectorAll('td');
            rows.push([
                cells[0].innerText.replace(/\n/g, ' ').trim(),
                cells[1].innerText.trim(),
                cells[2].innerText.trim(),
                cells[3].innerText.trim(),
                cells[4].innerText.replace(/\s+/g, ' ').trim()
            ]);
        });

        const csv = '\uFEFF' + rows
            .map(row => row.map(value =>
                '"' + String(value).replace(/"/g, '""') + '"'
            ).join(';'))
            .join('\r\n');

        const blob = new Blob([csv], {
            type: 'text/csv;charset=utf-8;'
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = 'statistiques-sgec.csv';
        document.body.appendChild(link);
        link.click();
        link.remove();

        URL.revokeObjectURL(url);
    }

    document.addEventListener('DOMContentLoaded', function () {
        initializeCharts();

        document.getElementById('periodFilter')
            .addEventListener('change', applyFilters);

        document.getElementById('serviceFilter')
            .addEventListener('change', applyFilters);
    });
</script>

{% endblock %}
