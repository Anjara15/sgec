{% extends 'layouts/app.html.twig' %}
{% set pageHeading = 'Utilisateurs' %}
{% block title %}Utilisateurs | SGEC{% endblock %}
{% block content %}
<div class="page-heading">
    <div>
        <h1 class="page-title">Utilisateurs</h1>
        <p class="muted mb-0">Gérez les comptes et leurs accès aux espaces de travail.</p>
    </div>
    <a href="{{ path('app_user_new') }}" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Nouvel utilisateur</a>
</div>
<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Nom</th><th>E-mail</th><th>Service</th><th>Rôles</th><th>Statut du compte</th><th>Actions</th></tr></thead>
            <tbody>
            {% for u in users %}
                <tr>
                    <td>{{ u.nomComplet }}</td>
                    <td>{{ u.email }}</td>
                    <td>{{ u.service ?: '—' }}</td>
                    <td>{{ u.roles|join(', ') }}</td>
                    <td><span class="badge bg-light text-dark border">{{ u.statut.label }}</span></td>
                    <td class="text-nowrap">
                        <a href="{{ path('app_user_edit', {id: u.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Modifier</a>
                        <form method="post" action="{{ path('app_user_delete', {id: u.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                            <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1"></i>Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="empty-state">Aucun utilisateur enregistré.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
