{% extends 'layouts/app.html.twig' %}
{% set pageHeading = 'Journal d\'activité' %}
{% block title %}Journal | SGEC{% endblock %}
{% block content %}
<div class="page-heading">
    <div>
        <h1 class="page-title">Journal d’activité</h1>
        <p class="muted mb-0">Suivez les opérations enregistrées dans le système.</p>
    </div>
</div>
<div class="panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Date</th><th>Utilisateur</th><th>Action</th><th>Objet</th><th>Informations</th></tr></thead>
            <tbody>
            {% for a in activites %}
                <tr>
                    <td class="text-nowrap">{{ a.date|date('d/m/Y H:i:s') }}</td>
                    <td>{{ a.utilisateur ? a.utilisateur.nomComplet : 'Système' }}</td>
                    <td>{{ a.action }}</td>
                    <td>{{ a.typeObjet }}{% if a.objetId %} #{{ a.objetId }}{% endif %}</td>
                    <td><small>{{ a.infos|json_encode }}</small></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="empty-state">Aucune activité enregistrée.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
